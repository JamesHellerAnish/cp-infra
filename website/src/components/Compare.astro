---
// Then and now: two photographs of the same element in one frame, switched with two buttons.
export interface Props {
  before: string;
  after: string;
  beforeLabel: string;
  afterLabel: string;
  beforeCaption: string;
  afterCaption: string;
}
const { before, after, beforeLabel, afterLabel, beforeCaption, afterCaption } = Astro.props;
---

<figure class="thennow" data-state="after">
  <div class="thennow__frame">
    <img class="thennow__a" src={before} alt={beforeCaption} loading="lazy" />
    <img class="thennow__b" src={after} alt={afterCaption} loading="lazy" />
  </div>
  <div class="thennow__bar" role="group" aria-label="Show the photograph">
    <button type="button" data-show="before" aria-pressed="false">{beforeLabel}</button>
    <button type="button" data-show="after" aria-pressed="true">{afterLabel}</button>
  </div>
  <figcaption class="thennow__cap" aria-live="polite">{afterCaption}</figcaption>
</figure>

<script define:vars={{ beforeCaption, afterCaption }}>
  document.querySelectorAll('.thennow').forEach((fig) => {
    const cap = fig.querySelector('.thennow__cap');
    fig.querySelectorAll('[data-show]').forEach((b) => b.addEventListener('click', () => {
      const s = b.dataset.show;
      fig.dataset.state = s;
      fig.querySelectorAll('[data-show]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      cap.textContent = s === 'before' ? beforeCaption : afterCaption;
    }));
  });
</script>

<style>
  .thennow__frame { position: relative; aspect-ratio: 5 / 4; overflow: hidden; background: #0a1a33; }
  .thennow__frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity 500ms ease, transform 900ms var(--ease-out); }
  .thennow[data-state='after'] .thennow__a { opacity: 0; transform: scale(1.04); }
  .thennow[data-state='before'] .thennow__b { opacity: 0; transform: scale(1.04); }
  .thennow__bar { display: grid; grid-template-columns: 1fr 1fr; }
  .thennow__bar button { min-height: 56px; font-weight: 700; background: var(--surface); color: var(--navy); transition: background-color var(--t-hover), color var(--t-hover); }
  .thennow__bar button[aria-pressed='true'] { background: var(--gold); color: var(--navy-deep); }
  .thennow__bar button:active { transform: scale(0.98); }
  @media (hover: hover) and (pointer: fine) { .thennow__bar button[aria-pressed='false']:hover { background: #fff; } }
  @media (prefers-reduced-motion: reduce) { .thennow__frame img { transition: none; } }
</style>
