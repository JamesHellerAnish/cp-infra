---
export interface Props { overHero?: boolean }
const { overHero = true } = Astro.props;
const path = Astro.url.pathname;

const projects = [
  { label: 'Tehri Dam', href: '/projects/tehri-dam/', what: 'Dredging, baffle wall, tunnel repair' },
  { label: 'Badrinath Dham', href: '/projects/badrinath-dham/', what: 'Riverfronts, bridge, civic centre' },
  { label: 'Hailang Dam (VPHEP)', href: '/projects/hailang-dam/', what: 'Gate groove restoration' },
  { label: 'Kedarnath Dham', href: '/projects/kedarnath-dham/', what: 'Pilgrim accommodation' },
  { label: 'Bhutan Granite Mine', href: '/projects/bhutan-mine/', what: '85 acres, Wangdue' },
  { label: 'Kekri Granite Mine', href: '/projects/kekri-mine/', what: 'Rajasthan' },
  { label: 'Other projects', href: '/projects/other/', what: 'Across India' },
];
const specialities = [
  { label: 'Hydropower & river dredging', href: '/speciality/hydropower/' },
  { label: 'Mining & exploration', href: '/speciality/mining/' },
  { label: 'Civil & mechanical works', href: '/speciality/civil/' },
];
const inProjects = path.startsWith('/projects/');
const inSpeciality = path.startsWith('/speciality/');
---

<header class:list={['hdr', { 'hdr--over': overHero }]} id="hdr">
  <div class="hdr__inner wrap">
    <a href="/" class="hdr__brand" aria-label="CP Systems, home">
      <img src="/images/cp-logo.webp" alt="" width="40" height="40" />
      <span>CP Systems</span>
    </a>

    <nav class="hdr__nav" aria-label="Main">
      <ul class="hdr__list" id="hdrList">
        <li class="hdr__item"><a class:list={['hdr__link', { 'is-current': path === '/' }]} href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
        <li class="hdr__item">
          <button class:list={['hdr__link', { 'is-current': inProjects }]} aria-expanded="false" aria-controls="menu-projects" data-menu>
            Projects
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <ul class="hdr__menu" id="menu-projects">
            {projects.map((p) => (
              <li><a href={p.href} aria-current={path === p.href ? 'page' : undefined}><span>{p.label}</span><small>{p.what}</small></a></li>
            ))}
          </ul>
        </li>
        <li class="hdr__item">
          <button class:list={['hdr__link', { 'is-current': inSpeciality }]} aria-expanded="false" aria-controls="menu-speciality" data-menu>
            Expertise
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <ul class="hdr__menu" id="menu-speciality">
            {specialities.map((p) => (
              <li><a href={p.href} aria-current={path === p.href ? 'page' : undefined}><span>{p.label}</span></a></li>
            ))}
          </ul>
        </li>
        <li class="hdr__item"><a class:list={['hdr__link', { 'is-current': path === '/about/' }]} href="/about/">About</a></li>
        <li class="hdr__item hdr__item--cta"><a class="btn hdr__cta" href="/contact/">Contact</a></li>
      </ul>
    </nav>

    <button class="hdr__burger" id="hdrBurger" aria-expanded="false" aria-controls="hdrList">Menu</button>
  </div>
</header>

<script>
  const hdr = document.getElementById('hdr')!;
  const burger = document.getElementById('hdrBurger')!;
  const menus = [...document.querySelectorAll<HTMLButtonElement>('[data-menu]')];

  const onScroll = () => hdr.classList.toggle('is-solid', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  function closeAll(except?: HTMLButtonElement) {
    menus.forEach((b) => { if (b !== except) b.setAttribute('aria-expanded', 'false'); });
  }
  menus.forEach((b) => {
    b.addEventListener('click', () => {
      const open = b.getAttribute('aria-expanded') === 'true';
      closeAll(b);
      b.setAttribute('aria-expanded', String(!open));
    });
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.hdr__item')) closeAll();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = menus.find((b) => b.getAttribute('aria-expanded') === 'true');
    closeAll();
    open?.focus();
    if (hdr.classList.contains('is-open')) { hdr.classList.remove('is-open'); burger.setAttribute('aria-expanded', 'false'); burger.textContent = 'Menu'; burger.focus(); }
  });
  burger.addEventListener('click', () => {
    const open = hdr.classList.toggle('is-open');
    burger.setAttribute('aria-expanded', String(open));
    burger.textContent = open ? 'Close' : 'Menu';
    document.body.style.overflow = open ? 'hidden' : '';
  });
</script>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 50;
    background: var(--navy); color: #fff;
    transition: background-color 240ms ease, box-shadow 240ms ease; /* taste-skill-ignore: state indicator or list separator, not a resting shadow */
  }
  .hdr--over { position: fixed; inset: 0 0 auto 0; background: transparent; }
  .hdr--over.is-solid, .hdr.is-open { background: var(--navy); box-shadow: 0 6px 24px rgba(2, 16, 40, 0.25); } /* taste-skill-ignore: floating overlay */
  .hdr__inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 72px; }

  .hdr__brand { display: flex; align-items: center; gap: 12px; text-decoration: none; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.02em; }
  .hdr__brand img { width: 40px; height: 40px; border-radius: 50%; background: #fff; }

  .hdr__list { display: flex; align-items: center; gap: 4px; }
  .hdr__item { position: relative; }
  .hdr__link {
    display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 14px;
    font-weight: 600; font-size: 1rem; text-decoration: none; color: #fff;
    box-shadow: inset 0 -3px 0 transparent; transition: box-shadow var(--t-hover); /* taste-skill-ignore: state indicator or list separator, not a resting shadow */
  }
  .hdr__link.is-current { box-shadow: inset 0 -3px 0 var(--gold); } /* taste-skill-ignore: state indicator or list separator, not a resting shadow */
  .hdr__link svg { transition: transform 200ms var(--ease-out); }
  .hdr__link[aria-expanded='true'] svg { transform: rotate(180deg); }
  @media (hover: hover) and (pointer: fine) { .hdr__link:hover { box-shadow: inset 0 -3px 0 var(--gold); } } /* taste-skill-ignore: state indicator or list separator, not a resting shadow */
  .hdr__item--cta { margin-left: 12px; }
  .hdr__cta { min-height: 44px; padding: 0 20px; }

  .hdr__menu {
    position: absolute; top: calc(100% + 10px); left: 0; min-width: 320px;
    background: #fff; color: var(--ink); padding: 8px;
    box-shadow: 0 18px 48px rgba(2, 16, 40, 0.28); /* taste-skill-ignore: floating overlay */
    display: none;
  }
  [aria-expanded='true'] + .hdr__menu { display: block; }
  @media (prefers-reduced-motion: no-preference) { [aria-expanded='true'] + .hdr__menu { animation: menuIn 220ms var(--ease-out); } }
  @keyframes menuIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  .hdr__menu a { display: grid; padding: 12px 14px; text-decoration: none; transition: background-color var(--t-hover); }
  .hdr__menu a span { font-weight: 700; color: var(--navy); }
  .hdr__menu a small { font-size: var(--t-small); color: var(--muted); }
  .hdr__menu a[aria-current='page'] { background: var(--surface); }
  @media (hover: hover) and (pointer: fine) { .hdr__menu a:hover { background: var(--surface); } }

  .hdr__burger { display: none; height: 44px; padding: 0 16px; font-weight: 700; color: #fff; background: rgba(255, 255, 255, 0.14); }

  @media (max-width: 880px) {
    .hdr__inner { height: 64px; }
    .hdr__burger { display: block; }
    .hdr__nav { position: fixed; inset: 64px 0 0 0; background: var(--navy); overflow-y: auto; padding: 16px var(--margin) 40px; display: none; }
    .hdr.is-open .hdr__nav { display: block; }
    .hdr__list { flex-direction: column; align-items: stretch; gap: 0; }
    .hdr__link { width: 100%; height: 60px; font-size: 1.375rem; font-weight: 700; padding: 0; justify-content: space-between; box-shadow: none !important; } /* taste-skill-ignore: state indicator or list separator, not a resting shadow */
    .hdr__menu { position: static; min-width: 0; box-shadow: none; background: transparent; padding: 0 0 12px; } /* taste-skill-ignore: state indicator or list separator, not a resting shadow */
    .hdr__menu a span { color: #fff; }
    .hdr__menu a small { color: var(--on-navy-muted); }
    .hdr__menu a { padding: 10px 0; }
    .hdr__menu a[aria-current='page'] span { color: var(--gold); }
    .hdr__item--cta { margin: 24px 0 0; }
    .hdr__cta { width: 100%; min-height: 56px; }
  }
</style>
