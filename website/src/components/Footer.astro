<style>
  .ftr {
    display: grid; grid-template-rows: auto auto;
    background: var(--navy-deep); color: var(--on-navy-muted);
    padding-top: clamp(40px, 4.5vw, 64px);
  }
  .ftr__cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 40px var(--gap); }
  .ftr__h { font-size: 1rem; letter-spacing: 0; color: #fff; margin-bottom: 14px; font-weight: 700; }
  .ftr address { font-style: normal; font-size: 1rem; line-height: 1.6; }
  .ftr li { font-size: 1rem; line-height: 1.5; padding: 4px 0; }
  .ftr a { text-decoration: none; transition: color var(--t-hover); }
  @media (hover: hover) and (pointer: fine) { .ftr a:hover { color: var(--gold); } }
  .ftr__legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; font-size: var(--t-small); padding-block: 20px 28px; margin-top: clamp(32px, 4vw, 48px); max-width: none; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12); } /* taste-skill-ignore: state indicator or list separator, not a resting shadow */
  @media (max-width: 760px) {
    .ftr__cols { grid-template-columns: 1fr 1fr; gap: 32px 20px; }
    }
  .ftr__legal p { max-width: none; }
  .ftr__credit { margin-left: auto; text-align: right; }
  .ftr__credit a { color: #fff; font-weight: 600; }
</style>
