---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact CP Systems" description="Contact CP Systems Pvt. Ltd., Netaji Subhash Place, Pitampura, New Delhi. Phone 011 4053 9469, info@cp-infra.in." overHero={false}>
  <section class="ct section" aria-labelledby="ct-h">
    <div class="wrap ct__grid">
      <div class="ct__intro" data-reveal>
        <h1 id="ct-h">Talk to CPS</h1>
        <p class="lead">Tell us about the site, the dates and the problem. Your message opens in your email app, addressed to our team, ready to send.</p>
        <dl class="ct__rows">
          <div><dt>Office</dt><dd><a href="tel:01140539469">011 4053 9469</a></dd></div>
          <div><dt>Mobile</dt><dd><a href="tel:+919212150206">+91 92121 50206</a><br /><a href="tel:+919819953664">+91 98199 53664</a></dd></div>
          <div><dt>Email</dt><dd><a href="mailto:info@cp-infra.in">info@cp-infra.in</a><br /><a href="mailto:cpsystems_ho@cp-infra.in">cpsystems_ho@cp-infra.in</a><br /><a href="mailto:sanjay_cpsystem@cp-infra.in">sanjay_cpsystem@cp-infra.in</a></dd></div>
          <div><dt>Address</dt><dd>501, Krishna Apra Business Square, Netaji Subhash Place, Pitampura, New Delhi 110034</dd></div>
        </dl>
      </div>

      <form class="form ct__form" id="ctForm" action="mailto:info@cp-infra.in" method="post" enctype="text/plain">
        <div class="form__row">
          <div><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required /></div>
          <div><label for="org">Organisation</label><input id="org" name="organisation" autocomplete="organization" /></div>
        </div>
        <div class="form__row">
          <div><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
          <div><label for="phone">Phone</label><input id="phone" name="phone" type="tel" autocomplete="tel" /></div>
        </div>
        <div>
          <label for="kind">Kind of work</label>
          <select id="kind" name="kind">
            <option>Hydropower: dam, tunnel or intake repair</option>
            <option>River dredging or river training</option>
            <option>Drilling, grouting or slope stabilisation</option>
            <option>Civil or mechanical construction</option>
            <option>Granite: blocks, slabs or crafted stone</option>
            <option>Something else</option>
          </select>
        </div>
        <div><label for="subject">Subject</label><input id="subject" name="subject" value="Project enquiry" /></div>
        <div><label for="message">About the work</label><textarea id="message" name="message" required placeholder="Site, scope, shutdown or season window, and when you need it done"></textarea></div>
        <button type="submit" class="btn">Write the email</button>
      </form>
    </div>
  </section>

  <section class="section field-navy" aria-labelledby="sites-h">
    <div class="wrap">
      <h2 id="sites-h" data-reveal><span>Where your message may lead</span></h2>
      <ul class="sites" data-reveal>
        <li><a href="/projects/tehri-dam/"><div class="media ratio-45"><img src="/media/posters/tehri-ramp-concreting.jpg" alt="" loading="lazy" /></div><span>Tehri Dam</span></a></li>
        <li><a href="/projects/badrinath-dham/"><div class="media ratio-45"><img src="/media/posters/badrinath-approach.jpg" alt="" loading="lazy" /></div><span>Badrinath Dham</span></a></li>
        <li><a href="/projects/hailang-dam/"><div class="media ratio-45"><img src="/media/posters/hailang-cofferdam-aerial.jpg" alt="" loading="lazy" /></div><span>Hailang Dam</span></a></li>
        <li><a href="/projects/bhutan-mine/"><div class="media ratio-45"><img src="/media/posters/bhutan-blocks-valley.jpg" alt="" loading="lazy" /></div><span>Bhutan Granite Mine</span></a></li>
      </ul>
    </div>
  </section>

</BaseLayout>

<script>
  // Prefill the subject from links such as /contact/?subject=Granite%20enquiry, and build a readable email.
  const form = document.getElementById('ctForm') as HTMLFormElement;
  const q = new URLSearchParams(location.search).get('subject');
  if (q) (form.elements.namedItem('subject') as HTMLInputElement).value = q;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const f = new FormData(form);
    const body = [
      `Name: ${f.get('name')}`,
      f.get('organisation') ? `Organisation: ${f.get('organisation')}` : '',
      `Email: ${f.get('email')}`,
      f.get('phone') ? `Phone: ${f.get('phone')}` : '',
      `Kind of work: ${f.get('kind')}`,
      '',
      String(f.get('message')),
    ].filter((l, i) => l !== '' || i === 5).join('\n');
    location.href = `mailto:info@cp-infra.in?subject=${encodeURIComponent(String(f.get('subject') || 'Project enquiry'))}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .ct { padding-top: clamp(64px, 9vw, 128px); }
  .ct__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 32px var(--gap); align-items: start; }
  .ct__intro { grid-column: 1 / span 5; }
  .ct__intro .lead { margin-top: 24px; }
  .ct__rows { margin-top: 40px; display: grid; gap: 4px; }
  .ct__rows div { display: grid; grid-template-columns: 100px 1fr; gap: 16px; padding: 14px 0; box-shadow: inset 0 -2px 0 rgba(4, 45, 106, 0.08); } /* taste-skill-ignore: state indicator or list separator, not a resting shadow */
  .ct__rows dt { font-weight: 700; color: var(--muted); font-size: 1rem; }
  .ct__rows a { color: var(--navy); font-weight: 700; text-decoration: none; }
  @media (hover: hover) and (pointer: fine) { .ct__rows a:hover { text-decoration: underline; text-decoration-color: var(--gold); } }
  .ct__form { grid-column: 7 / span 6; background: var(--surface); padding: clamp(24px, 3vw, 40px); }
  .ct__form .btn { justify-self: start; }
  .sites { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap); margin-top: 28px; }
  .sites a { display: grid; gap: 14px; text-decoration: none; font-weight: 700; font-size: 1.125rem; color: #fff; }
  .sites img { transition: transform 700ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .sites a:hover img { transform: scale(1.04); } .sites a:hover span { color: var(--gold); } }
  @media (max-width: 900px) { .sites { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 900px) { .ct__intro, .ct__form { grid-column: 1 / -1; } }
</style>
