---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Chapter from '../../components/Chapter.astro';
import Clip from '../../components/Clip.astro';
import Gallery from '../../components/Gallery.astro';
import NextProjects from '../../components/NextProjects.astro';

const chapters = [
  ['conditions', 'Conditions'],
  ['riverfront-a', 'Riverfront A'],
  ['riverfront-f', 'Riverfront F1'],
  ['bridge-civic', 'Bridge and civic centre'],
];
---

<BaseLayout title="Badrinath Dham — CP Systems" description="Riverfront development, a 47 m pedestrian bridge and a civic centre on the Alaknanda at Shri Badrinath Dham, Uttarakhand.">
  <PageHero
    title="Badrinath Dham"
    lead="Three riverfronts, a 47 m footbridge and a civic centre, built on the Alaknanda in front of one of India's holiest shrines."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Projects' }, { label: 'Badrinath Dham' }]}
    clip="badrinath-approach"
    facts={[
      { label: 'Client', value: 'THDCIL / Uttarakhand Govt.' },
      { label: 'River', value: 'Alaknanda' },
      { label: 'Bridge span', value: '47 m' },
      { label: 'Working season', value: 'April – December' },
    ]}
  />

  <nav class="pindex" aria-label="Parts of the Badrinath work">
    <div class="pindex__track">{chapters.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</div>
  </nav>

  <section class="section" id="content" aria-labelledby="ov-h">
    <div class="wrap split">
      <div class="split__a" data-reveal>
        <h2 id="ov-h">A riverfront for the yatra</h2>
        <p class="lead" style="margin-top:24px">The redevelopment of Shri Badrinath Dham runs along both banks of the Alaknanda. CPS built three riverfronts, the pedestrian bridge between them and a civic centre near Badrish Lake.</p>
        <p style="margin-top:18px">Every part of it had to be founded below a fast, freezing river, and finished between yatra crowds.</p>
      </div>
      <div class="split__b" data-gallery>
        <Clip name="badrinath-excavator-river" />
      </div>
    </div>
  </section>

  <section id="conditions" class="section field-navy" aria-labelledby="cond-h">
    <div class="wrap">
      <h2 id="cond-h" data-reveal><span>What the site asked of us</span></h2>
      <div class="cond" data-gallery>
        <article class="cond__item" data-reveal>
          <Clip name="badrinath-winter" ratio="ratio-45" bare />
          <p class="cond__fig">−10 to 20 °C</p>
          <p>Below zero from October to April. Concrete takes longer to set even with admixtures, so pours are planned around the cold.</p>
        </article>
        <article class="cond__item" data-reveal>
          <Clip name="badrinath-bucket-crossing" ratio="ratio-45" bare />
          <p class="cond__fig">5–7 m below the bed</p>
          <p>Foundations in bouldery strata with seepage that 10–12 dewatering pumps could not fully stop. Some days the only way across was the bucket.</p>
        </article>
        <article class="cond__item" data-reveal>
          <Clip name="badrinath-night" ratio="ratio-45" bare />
          <p class="cond__fig">May – November yatra</p>
          <p>Pilgrim traffic restricts equipment movement and slows material supply, with homes on both banks. Work carries on after dark.</p>
        </article>
      </div>
    </div>
  </section>

  <Chapter id="riverfront-a" title="Riverfront A, right bank" when="Right bank" whenNote="Alaknanda River" pair
    scope={['Extensive dewatering of the work area', 'Foundation excavation in bouldery strata', 'Reinforcement binding and wall concreting', 'Approaches built into the running river']}>
    <p>Riverfront A on the right bank: dewatering, excavation through boulders, reinforcement and concrete, much of it in freezing conditions.</p>
    <Fragment slot="media">
      <Clip name="badrinath-riverfront-wall" />
      <Clip name="badrinath-wall-concreting" />
    </Fragment>
    <Gallery slot="row" title="Riverfront A, photographed" items={[
      { src: '/images/slide_93_img_1.jpg', caption: 'Riverfront A at Shri Badrinath' },
      { src: '/images/slide_93_img_2.jpg', caption: 'Construction along the Alaknanda' },
      { src: '/images/slide_95_img_1.jpg', caption: 'Dewatering in Riverfront A' },
      { src: '/images/slide_96_img_1.jpg', caption: 'Dewatering and concreting' },
      { src: '/images/slide_97_img_1.jpg', caption: 'Reinforcement binding' },
      { src: '/images/slide_98_img_1.jpg', caption: 'Reinforcement, dewatering and concreting', tall: true },
      { src: '/images/expansion/badrinath_rf_a_2.jpg', caption: 'Riverfront A wall along the river' },
      { src: '/images/expansion/badrinath_rf_a_4.jpg', caption: 'Wall foundation works' },
      { src: '/images/expansion/badrinath_rf_a_7.jpg', caption: 'Riverfront A in progress' },
      { src: '/images/expansion/badrinath_rf_a_10.jpg', caption: 'Riverfront A reinforcement' },
    ]} />
  </Chapter>

  <Chapter id="riverfront-f" title="Riverfront F1, left bank" when="Left bank" whenNote="Alaknanda River" field="surface" flip pair
    scope={['Seepage from the bank and the river side', 'Continuous dewatering with diesel pumps', 'Temporary approach built into the river', 'Reinforcement and concreting in the dewatered pit']}>
    <p>Riverfront F on the left bank, with the same boulders and even more water coming in from both sides.</p>
    <Fragment slot="media">
      <Clip name="badrinath-dewatering" />
      <Clip name="badrinath-river-approach" />
    </Fragment>
    <Gallery slot="row" title="Riverfront F1, photographed" items={[
      { src: '/images/slide_99_img_1.jpg', caption: 'Reinforcement binding at Riverfront F' },
      { src: '/images/slide_99_img_2.jpg', caption: 'Dewatering and concreting at Riverfront F' },
      { src: '/images/slide_94_img_1.jpg', caption: 'Making an approach in the Alaknanda' },
      { src: '/images/expansion/badrinath_rf_a_5.jpg', caption: 'Left bank works' },
      { src: '/images/expansion/badrinath_rf_a_11.jpg', caption: 'Dewatered foundation' },
    ]} />
  </Chapter>

  <Chapter id="bridge-civic" title="Footbridge and civic centre" when="47 m span" whenNote="Near Badrish Lake" pair
    scope={['Bridge foundations 5–7 m below the riverbed', 'Raft and column reinforcement for the civic centre', 'Concrete pumped across the site', 'Structure carried on through winter snow']}>
    <p>A 47 m pedestrian bridge across the Alaknanda, and a Civic Centre building near Badrish Lake. The bridge piers sit 5–7 m below the riverbed, so seepage control set the pace.</p>
    <Fragment slot="media">
      <Clip name="badrinath-bridge-pier" />
      <Clip name="badrinath-raft-rebar" />
      <Clip name="badrinath-civic-snow" />
      <Clip name="badrinath-concrete-pump" />
    </Fragment>
    <Gallery slot="row" title="Bridge and civic centre, photographed" items={[
      { src: '/images/slide_100_img_1.jpg', caption: 'Raft and column reinforcement, civic centre' },
      { src: '/images/slide_100_img_2.jpg', caption: 'Column reinforcement binding' },
      { src: '/images/slide_94_img_2.jpg', caption: 'River approach for the bridge foundation' },
      { src: '/images/slide_101_img_1.jpg', caption: 'Bridge construction' },
      { src: '/images/slide_102_img_1.jpg', caption: 'Building structure rising' },
      { src: '/images/slide_103_img_1.jpg', caption: 'Bridge and civic centre overview' },
      { src: '/images/expansion/badrinath_civic_1.jpg', caption: 'Civic centre frame' },
      { src: '/images/expansion/badrinath_civic_2.jpg', caption: 'Civic centre and the valley' },
    ]} />
  </Chapter>

  <NextProjects current="/projects/badrinath-dham/" />
</BaseLayout>

<style>
  .cond { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px var(--gap); margin-top: 56px; }
  .cond__fig { font-size: clamp(1.75rem, 2.6vw, 2.5rem); font-weight: 800; letter-spacing: -0.03em; color: var(--gold); line-height: 1.05; margin: 24px 0 12px; }
  .cond__item p:last-child { color: var(--on-navy); }
  @media (max-width: 900px) { .cond { grid-template-columns: 1fr; } }
</style>
