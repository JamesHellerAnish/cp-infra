---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Chapter from '../../components/Chapter.astro';
import Photo from '../../components/Photo.astro';
import Clip from '../../components/Clip.astro';
import Gallery from '../../components/Gallery.astro';
import NextProjects from '../../components/NextProjects.astro';

const more = [
  ['Nagpur–Mumbai Expressway', 'Passive fire protection, package 14'],
  ['Rajpura Thermal Power', 'Civil works, site grading and a minor bridge'],
  ['Nagloi CETP, Delhi', 'Structural treatment of 12 and 24 MLD plants'],
  ['GAIL gas pipeline', '294 km of joint coating, Jaipur to Loni'],
  ['HMEL Bhatinda Refinery', 'Specialised insulation'],
  ['AIIMS Bhopal', 'PU foam insulation and PVC membrane waterproofing'],
];
---

<BaseLayout title="Other projects — CP Systems" description="Dam repair, spillway rehabilitation, slope stabilisation and tunnel grouting at Tapovan, Maneri Bhali, Koteshwar, Pipalkoti and Sewa II.">
  <PageHero
    title="Other projects"
    lead="Dam repair, spillway rehabilitation, slope stabilisation and tunnel grouting across the hydropower projects of Uttarakhand and J&K."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Projects' }, { label: 'Other projects' }]}
    image="/images/other_projects/maneri_bhali_1.jpg"
    imageAlt="Spillway repair at Maneri Bhali Stage-I"
    facts={[
      { label: 'Koteshwar', value: '36 months' },
      { label: 'Pipalkoti TBM', value: '1.5 years' },
      { label: 'Sewa II tunnel', value: '10 km' },
    ]}
  />

  <nav class="pindex" aria-label="Projects on this page">
    <div class="pindex__track">
      <a href="#tapovan">Tapovan</a><a href="#maneri">Maneri Bhali</a><a href="#koteshwar">Koteshwar</a><a href="#pipalkoti">Pipalkoti TBM</a><a href="#sewa">Sewa II</a><a href="#more">Across India</a>
    </div>
  </nav>

  <Chapter id="tapovan" title="Tapovan Vishnugad HPP" when="RC dam repair" whenNote="Rebaring and micro concrete" pair
    scope={['Loose concrete removed', 'Rebaring with couplers and shear connectors', 'High-strength micro concrete', 'Epoxy mortar finish']}>
    <p id="content">Repair and structural strengthening of the dam's reinforced concrete: damaged concrete cut out, new steel coupled in, and the section rebuilt in micro concrete and epoxy mortar.</p>
    <Fragment slot="media">
      <Photo src="/images/other_projects/tapovan_3.jpg" caption="Rebaring" ratio="ratio-45" showCaption />
      <Photo src="/images/other_projects/tapovan_5.jpg" caption="Micro concreting" ratio="ratio-45" showCaption />
    </Fragment>
    <Gallery slot="row" title="Tapovan, photographed" items={[
      { src: '/images/other_projects/tapovan_1.jpg', caption: 'Structure under repair' },
      { src: '/images/other_projects/tapovan_2.jpg', caption: 'Damaged concrete removed' },
      { src: '/images/other_projects/tapovan_4.jpg', caption: 'Couplers on the new reinforcement' },
      { src: '/images/other_projects/tapovan_6.jpg', caption: 'Completed repair' },
    ]} />
  </Chapter>

  <Chapter id="maneri" title="Maneri Bhali Stage-I Dam" when="Spillway and roller bucket" whenNote="Lean season, under water" field="surface" flip pair
    scope={['Profile matching in M80 concrete', 'Rebaring and epoxy grouting', 'MS plate liners for spillway and roller buckets', 'Seal beams and silt-eroded cavities rebuilt']}>
    <p>Damaged seal beams, heavy silt erosion and deep cavities in the spillway and roller bucket, repaired under water in the lean season.</p>
    <Fragment slot="media">
      <Photo src="/images/other_projects/maneri_bhali_3.jpg" caption="Roller bucket repair" ratio="ratio-45" showCaption />
      <Photo src="/images/other_projects/maneri_bhali_4.jpg" caption="Completed works" ratio="ratio-45" showCaption />
    </Fragment>
    <Gallery slot="row" title="Maneri Bhali, photographed" items={[
      { src: '/images/other_projects/maneri_bhali_1.jpg', caption: 'Spillway repair' },
      { src: '/images/other_projects/maneri_bhali_2.jpg', caption: 'Work in progress' },
    ]} />
  </Chapter>

  <Chapter id="koteshwar" title="Koteshwar Hydroelectric Project" when="36 months" whenNote="Left bank, up to 200 m" pair
    scope={['20,000+ sqm secured with rock bolts and chain link', 'Shotcreting of the slope', 'Epoxy and PU grouting at the power intake', 'Turbine base plates and construction joints treated']}>
    <p>Stabilisation of the left bank up to 200 m above the riverbed, then grouting and epoxy treatment at the power intake and turbine bases.</p>
    <Fragment slot="media">
      <Photo src="/images/other_projects/koteshwar_1.jpg" caption="Slope stabilisation on the left bank" ratio="ratio-45" showCaption />
      <Photo src="/images/other_projects/koteshwar_2.jpg" caption="Shotcreting" ratio="ratio-45" showCaption />
    </Fragment>
  </Chapter>

  <Chapter id="pipalkoti" title="VPHEP Pipalkoti: freeing the TBM" when="From 2021" whenNote="1.5 years" field="navy" flip pair
    scope={['Consolidation drilling in fragile, sandy strata', 'Polyurethane grouting', 'Microfine cement grouting', 'Colloidal silica injection']}>
    <p>In 2021 the tunnel boring machine at VPHEP stuck fast in a fragile section of the HRT. Over a year and a half CPS drilled and grouted the sandy ground around it until the TBM could move again.</p>
    <Fragment slot="media">
      <Photo src="/images/other_projects/pipalkoti_grouting_4.jpg" caption="PU pumping" ratio="ratio-45" showCaption />
      <Photo src="/images/other_projects/pipalkoti_grouting_6.jpg" caption="The TBM released" ratio="ratio-45" showCaption />
    </Fragment>
    <Gallery slot="row" title="Pipalkoti, photographed" items={[
      { src: '/images/other_projects/pipalkoti_grouting_3.jpg', caption: 'Fragile strata at the TBM' },
      { src: '/images/other_projects/pipalkoti_grouting_2.jpg', caption: 'Colloidal silica', tall: true },
      { src: '/images/other_projects/pipalkoti_grouting_5.jpg', caption: 'Consolidation operations', tall: true },
      { src: '/images/other_projects/pipalkoti_grouting_7.jpg', caption: 'Grouting inside the tunnel' },
      { src: '/images/other_projects/pipalkoti_grouting_8.jpg', caption: 'Drilling for consolidation' },
    ]} />
  </Chapter>

  <Chapter id="sewa" title="Sewa II HEP, Jammu & Kashmir" when="2010" whenNote="10 km, 3.3 m diameter"
    scope={['Heavy machinery carried in by hand from few entry points', 'PU grouting to stop severe leakage', 'Epoxy mortar repair of the HRT']}>
    <p>Repair of a 10 km head race tunnel only 3.3 m across, with severe leakage. Machinery went in by hand through the few entry points.</p>
    <Fragment slot="media">
      <Photo src="/images/other_projects/sewa_1.jpg" caption="Inside the Sewa II HRT" ratio="ratio-32" showCaption />
    </Fragment>
  </Chapter>

  <section id="more" class="section field-surface" aria-labelledby="more-h">
    <div class="wrap split">
      <div class="split__a" data-reveal>
        <h2 id="more-h">Across India</h2>
        <p class="lead" style="margin-top:24px">Expressways, pipelines, refineries, treatment plants and buildings: the civil and protective work that runs alongside the hydropower.</p>
        <div style="margin-top:40px" data-gallery><Clip name="noida-building" caption="Column and slab work on a building in Noida" /></div>
      </div>
      <ul class="split__b index more">
        {more.map(([n, w]) => <li><span class="index__name">{n}</span><span class="index__what">{w}</span></li>)}
      </ul>
    </div>
  </section>

  <NextProjects current="/projects/other/" />
</BaseLayout>

<style>
  .more li { display: grid; gap: 6px; padding: 22px 0; box-shadow: inset 0 -2px 0 rgba(4, 45, 106, 0.1); } /* taste-skill-ignore: state indicator or list separator, not a resting shadow */
  .more .index__name { font-size: clamp(1.375rem, 2.4vw, 2rem); font-weight: 800; letter-spacing: -0.02em; color: var(--navy); line-height: 1.1; }
  .more .index__what { font-size: 1rem; color: var(--ink); }
</style>
