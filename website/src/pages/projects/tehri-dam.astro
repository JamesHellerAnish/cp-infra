---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Chapter from '../../components/Chapter.astro';
import Clip from '../../components/Clip.astro';
import Gallery from '../../components/Gallery.astro';
import NextProjects from '../../components/NextProjects.astro';

const chapters = [
  ['phase1-dredging', 'Dredging, phase 1'],
  ['phase1-baffle', 'Baffle wall'],
  ['phase2-dredging', 'Dredging, phase 2'],
  ['phase2-baffle', 'Ramps'],
  ['hrt-repair', 'HRT/TRT repair'],
  ['drainage-gallery', 'Drainage gallery'],
  ['surge-shaft', 'Surge shaft'],
  ['epoxy-intake', 'Intake epoxy'],
];
---

<BaseLayout title="Tehri Dam — CP Systems" description="River dredging, a 47 m baffle wall, HRT/TRT tunnel repair and intake epoxy treatment at Tehri HPP and PSP, Uttarakhand.">
  <PageHero
    title="Tehri Dam"
    lead="Eight jobs at India's tallest dam: dredging the Bhagirathi below the spillway, walling it, and repairing the tunnels and intakes that feed 1,000 MW."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Projects' }, { label: 'Tehri Dam' }]}
    clip="tehri-ramp-concreting"
    facts={[
      { label: 'Client', value: 'HCC / THDCIL' },
      { label: 'Location', value: 'Tehri, Uttarakhand' },
      { label: 'Dredged', value: '~2.5 lakh cum' },
      { label: 'Baffle wall', value: '47 m across the river' },
    ]}
  />

  <nav class="pindex" aria-label="Phases of the Tehri work">
    <div class="pindex__track">
      {chapters.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
    </div>
  </nav>

  <section class="section" id="content" aria-labelledby="ov-h">
    <div class="wrap split">
      <div class="split__a" data-reveal>
        <h2 id="ov-h">Working below the spillway</h2>
        <p class="lead" style="margin-top:24px">Tehri HPP (1,000 MW) and Tehri PSP only stop for short, scheduled shutdowns. Each CPS job had to fit inside one.</p>
        <p style="margin-top:18px">Below the dam the Bhagirathi rose and fell 8–10 m twice a day, leaving 3–4 hours of working time per shutdown. Inside the tunnels the only access was a crane down a 100 m surge shaft.</p>
      </div>
      <div class="split__b" data-gallery>
        <Clip name="tehri-gorge" ratio="ratio-45" />
      </div>
    </div>
  </section>

  <Chapter id="phase1-dredging" title="River dredging, phase 1" when="Feb – Jul 2023" whenNote="Zero schedule of Tehri HPP" field="surface" pair
    scope={[
      'Dredging to THDCIL’s daily zero schedule',
      '~1 lakh cum dredged and hauled 14–15 km',
      '12 excavators (210) and 2 long-boom excavators (300)',
      '50–60 dumpers for muck transport',
      '12 dewatering pumps, 50 HP each, 7,000–8,000 LPM',
      'Dedicated 30 cum batching plant and 6 transit mixers',
      'All resources deployed 24 hours in two shifts',
    ]}>
    <p>Dredging across 640 Rm of the Bhagirathi downstream of the spillway, done while the river level swung 8–10 m twice a day.</p>
    <Fragment slot="media">
      <Clip name="tehri-dredging" />
      <Clip name="tehri-dumpers" />
    </Fragment>
    <Gallery slot="row" title="Phase 1 dredging, photographed" items={[
      { src: '/images/slide_46_img_1.jpg', caption: 'River dredging operations' },
      { src: '/images/slide_47_img_1.jpg', caption: 'Water level at 604+ m', tall: true },
      { src: '/images/slide_48_img_1.jpg', caption: 'Excavation in variable water' },
      { src: '/images/slide_49_img_1.jpg', caption: 'Dredging, March 2023', tall: true },
      { src: '/images/slide_46_img_2.jpg', caption: 'Heavy machinery deployment', tall: true },
      { src: '/images/slide_49_img_3.jpg', caption: 'Water level 603.75 m' },
    ]} />
  </Chapter>

  <Chapter id="phase1-baffle" title="Baffle wall and micro piling" when="Feb – Jul 2023" whenNote="47 m across the Bhagirathi" flip pair
    scope={[
      '~2,000 cum RCC in 4 months',
      '1,000 mm dia Hume pipe through the wall',
      '700 m of micro piling in saturated foundation, ~400 Rm in one month',
      'Built in 5–10 m segments',
      'Underwater concreting by mobile boom placer',
      'Drilling and grouting of anchors on both banks',
    ]}>
    <p>A baffle wall about 47 m long across the river between the spillway and the TRT of Tehri HPP, poured under water onto a micro-piled, saturated riverbed.</p>
    <Fragment slot="media">
      <Clip name="tehri-boom-placer" />
      <Clip name="tehri-hume-pipe" />
    </Fragment>
    <Gallery slot="row" title="Building the wall" items={[
      { src: '/images/slide_54_img_3.jpg', caption: 'Baffle wall construction', tall: true },
      { src: '/images/slide_54_img_1.jpg', caption: 'Micro piling operations', tall: true },
      { src: '/images/slide_55_img_1.jpg', caption: 'Concreting in progress' },
      { src: '/images/slide_56_img_1.jpg', caption: 'Wall segment formation' },
      { src: '/images/slide_56_img_2.jpg', caption: 'Foundation reinforcement' },
      { src: '/images/slide_57_img_1.jpg', caption: 'Completed phase 1 baffle wall' },
    ]} />
  </Chapter>

  <Chapter id="phase2-dredging" title="River dredging, phase 2" when="Jun – Jul 2024" whenNote="A 35-day shutdown" field="surface"
    scope={[
      '1,50,000 cum dredged from chainage 260 m to 660 m',
      'ILO discharge never stopped; water never below EL 601.5 m',
      'A 12-day approach road built through the river',
      'A 12 m deep area found across the full river width',
      '20 more dumpers brought in mid-job',
      'Emergency wall for an exposed THDCIL building foundation',
    ]}>
    <p>The second phase dredged 1,50,000 cum and built 70 m ramps either side of the baffle wall, all inside a 35-day shutdown and through monsoon rain.</p>
    <Fragment slot="media">
      <Clip name="tehri-ramp-concreting" caption="Transit mixers on the ramp, June 2024" />
    </Fragment>
    <Gallery slot="row" title="Phase 2 on the riverbed" items={[
      { src: '/images/slide_59_img_1.jpg', caption: 'Phase 2 dredging operations' },
      { src: '/images/slide_63_img_1.jpg', caption: 'Excavation in progress' },
      { src: '/images/slide_63_img_2.jpg', caption: 'Riverbed operations' },
      { src: '/images/slide_64_img_1.jpg', caption: 'Machinery at work' },
      { src: '/images/slide_59_img_2.jpg', caption: 'Dumper loading' },
      { src: '/images/slide_64_img_2.jpg', caption: 'Approach construction' },
    ]} />
  </Chapter>

  <Chapter id="phase2-baffle" title="Ramps and micro piling, phase 2" when="Jun – Jul 2024" whenNote="14,400 cum concreted" flip
    scope={[
      '70 m ramps, 5 m wide, upstream and downstream',
      '~850 m of micro piling in the ramp foundation',
      'Underwater concrete by boom placer',
      'Built in 5–10 m segments because of seepage',
      'Foundation held at EL 601 m against a target of EL 598–600 m',
      'Shuttering fixed in standing water; buried formwork dug out',
    ]}>
    <p>Ramps 70 m long and 5 m wide along the Bhagirathi, piled and poured under water in the same shutdown.</p>
    <Fragment slot="media">
      <Clip name="tehri-micro-piling" />
      <div class="media ratio-32"><button type="button" data-lb="/images/slide_69_img_1.jpg" data-lb-caption="Underwater concrete pouring" aria-label="Open photograph: underwater concrete pouring"><img src="/images/slide_69_img_1.jpg" alt="Underwater concrete pouring" loading="lazy" /></button></div>
    </Fragment>
    <Gallery slot="row" title="The ramps" items={[
      { src: '/images/slide_68_img_1.jpg', caption: 'Ramp construction', tall: true },
      { src: '/images/slide_68_img_2.jpg', caption: 'Concreting by boom placer', tall: true },
      { src: '/images/slide_69_img_2.jpg', caption: 'Ramp concreting in progress' },
      { src: '/images/slide_68_img_3.jpg', caption: 'Ramp foundation' },
    ]} />
  </Chapter>

  <section id="hrt-repair" class="chapter section field-navy" aria-labelledby="hrt-h">
    <div class="wrap">
      <header class="chapter__head" data-reveal>
        <h2 class="chapter__title" id="hrt-h">Tunnel repair, 100 m down</h2>
        <p class="chapter__when">HRT #3 and #4<span>Tehri PSP, 8.5 m diameter</span></p>
      </header>
      <div class="hrt">
        <p class="lead hrt__lead" data-reveal>Repairing the 8.5 m head race tunnels meant lowering every worker and every bag through the surge shaft by crane, then moving the epoxy 700 m along the tunnel by hand.</p>
        <div class="hrt__pair">
          <article data-reveal>
            <h3>HRT #3</h3>
            <dl class="facts" style="--cols:2">
              <div><dt>Length repaired</dt><dd>23 m</dd></div>
              <div><dt>Epoxy mortar</dt><dd>~375 MT</dd></div>
              <div><dt>Done in</dt><dd>36 days</dd></div>
              <div><dt>Target</dt><dd>45 days</dd></div>
            </dl>
            <ul class="scope"><li>100–125 workers, round the clock</li><li>Material moved 700 m through the tunnel by hand</li></ul>
          </article>
          <article data-reveal>
            <h3>HRT #4</h3>
            <dl class="facts" style="--cols:2">
              <div><dt>Length repaired</dt><dd>32 m</dd></div>
              <div><dt>Epoxy mortar</dt><dd>~430 MT</dd></div>
              <div><dt>Done in</dt><dd>37 days</dd></div>
              <div><dt>Target</dt><dd>45 days</dd></div>
            </dl>
            <ul class="scope"><li>Custom electric mixers: a 110 kg batch in 5 minutes</li><li>12 mm shear connectors at 300 mm c/c, curved shuttering to the tunnel profile</li></ul>
          </article>
        </div>
        <div class="hrt__clips" data-gallery>
          <Clip name="tehri-epoxy-batching" class="hrt__wide" />
          <Clip name="tehri-curved-shuttering" />
          <Clip name="tehri-hrt-repair" />
          <Clip name="tehri-trt-outlet" />
        </div>
      </div>
    </div>
    <div class="chapter__row">
      <Gallery title="Inside the tunnels" items={[
        { src: '/images/slide_26_img_0.jpg', caption: 'TRT/HRT repair work', tall: true },
        { src: '/images/slide_31_img_0.jpg', caption: 'Epoxy mortar in HRT #3', tall: true },
        { src: '/images/slide_32_img_0.jpg', caption: 'Material moved by trolley' },
        { src: '/images/slide_34_img_4.jpg', caption: 'HRT #4 plug breaking area', tall: true },
        { src: '/images/slide_35_img_1.jpg', caption: 'Foundation epoxy work', tall: true },
        { src: '/images/slide_26_img_3.jpg', caption: 'Tunnel repair operations', tall: true },
        { src: '/images/expansion/tehri_trt_1.jpg', caption: 'TRT preparations', tall: true },
        { src: '/images/expansion/tehri_trt_2.jpg', caption: 'TRT surface preparation', tall: true },
        { src: '/images/expansion/tehri_trt_3.jpg', caption: 'TRT epoxy application', tall: true },
      ]} />
    </div>
  </section>

  <Chapter id="drainage-gallery" title="Drainage gallery drilling and grouting" when="Tehri PSP" whenNote="Seepage control" pair
    scope={['Drilling and grouting through the gallery network', 'Work in restricted, low tunnel sections']}>
    <p>Specialised drilling and grouting through the drainage galleries of Tehri PSP: stabilisation and seepage control done with very little room to move equipment.</p>
    <Fragment slot="media">
      <Clip name="tehri-drainage-gallery" />
      <div class="media ratio-916"><button type="button" data-lb="/images/expansion/tehri_drainage_1.jpg" data-lb-caption="Drilling and grouting in the drainage gallery" aria-label="Open photograph: drilling and grouting in the drainage gallery"><img src="/images/expansion/tehri_drainage_1.jpg" alt="Drilling and grouting in the drainage gallery" loading="lazy" /></button></div>
    </Fragment>
  </Chapter>

  <Chapter id="surge-shaft" title="Morning glory shaft epoxy treatment" when="Shafts T1 to T4" whenNote="Four months" field="surface" flip pair
    scope={['25 m scaffold built inside a 16 m shaft', 'Water falling 150–160 m turned aside with custom GI sheets', 'Epoxy treatment, mortar seals and fibreglass wrap']}>
    <p>Repair of the swirling-device bottom in all four surge shafts, with water falling continuously from 150–160 m above. A 25 m scaffold went up inside each 16 m shaft and the water was funnelled away from the work.</p>
    <Fragment slot="media">
      <Clip name="tehri-surge-shaft" />
      <div class="media ratio-916"><button type="button" data-lb="/images/expansion/tehri_surge_1.jpg" data-lb-caption="Scaffolding and water funnel in the surge shaft" aria-label="Open photograph: scaffolding and water funnel in the surge shaft"><img src="/images/expansion/tehri_surge_1.jpg" alt="Scaffolding and water funnel in the surge shaft" loading="lazy" /></button></div>
    </Fragment>
  </Chapter>

  <Chapter id="epoxy-intake" title="Epoxy treatment, intakes 1 and 2" when="31 May – 14 Jun 2025" whenNote="16 days against 30 planned"
    scope={[
      'Epoxy mortar at construction joints',
      'Old cement concrete wearing coat removed',
      'Epoxy paint on steel; steel work in the gates',
      'Bitumen felt removed over joints',
      'Four-course waterproofing with bitumen felt',
      'Stainless steel plates fixed over the felt',
    ]}>
    <p>Epoxy treatment at Intake Structures 1 and 2, EL 745 m, Tehri HPP. Planned for 30 days, handed over in 16.</p>
    <Fragment slot="media">
      <div class="media ratio-32"><button type="button" data-lb="/images/slide_39_img_0.jpg" data-lb-caption="Construction joint treatment at the intake" aria-label="Open photograph: construction joint treatment at the intake"><img src="/images/slide_39_img_0.jpg" alt="Construction joint treatment at the intake" loading="lazy" /></button></div>
      <div class="intake-pair">
        <div class="media ratio-45"><button type="button" data-lb="/images/slide_38_img_0.jpg" data-lb-caption="Intake structure epoxy work" aria-label="Open photograph: intake structure epoxy work"><img src="/images/slide_38_img_0.jpg" alt="Intake structure epoxy work" loading="lazy" /></button></div>
        <div class="media ratio-45"><button type="button" data-lb="/images/slide_39_img_1.jpg" data-lb-caption="Completed intake repair" aria-label="Open photograph: completed intake repair"><img src="/images/slide_39_img_1.jpg" alt="Completed intake repair" loading="lazy" /></button></div>
      </div>
    </Fragment>
  </Chapter>

  <section class="section field-surface tally" aria-labelledby="tally-h">
    <div class="wrap">
      <h2 id="tally-h" data-reveal><span>Tehri in three numbers</span></h2>
      <div class="tally__row">
        <div data-reveal><p class="figure-num">2.5<small> lakh cum</small></p><p>dredged across phases 1 and 2 and hauled 14 km</p></div>
        <div data-reveal><p class="figure-num">805<small> MT</small></p><p>of epoxy mortar in HRT #3 and #4, both inside the 45-day target</p></div>
        <div data-reveal><p class="figure-num">16<small> days</small></p><p>for the intake epoxy treatment, planned for 30</p></div>
      </div>
    </div>
  </section>

  <NextProjects current="/projects/tehri-dam/" />
</BaseLayout>

<style>
  .hrt { margin-top: 48px; }
  .hrt__lead { max-width: 52ch; color: var(--on-navy); }
  .hrt__pair { display: grid; grid-template-columns: 1fr 1fr; gap: 40px var(--gap); margin-top: 56px; }
  .hrt__pair h3 { font-size: clamp(1.75rem, 2.6vw, 2.5rem); font-weight: 800; color: var(--gold); margin-bottom: 24px; }
  .hrt__pair .scope { grid-template-columns: 1fr; margin-top: 20px; }
  .hrt__clips { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-auto-rows: auto; gap: var(--gap); margin-top: 64px; align-items: start; }
  .hrt__clips :global(.hrt__wide) { grid-column: 1; grid-row: span 2; }
  .hrt__clips > :global(:nth-child(2)) { grid-column: 2; grid-row: span 2; }
  .hrt__clips > :global(:nth-child(3)), .hrt__clips > :global(:nth-child(4)) { grid-column: 3; }
  .intake-pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap); }
  .chapter__media :global(button[data-lb]) { display: block; width: 100%; height: 100%; cursor: zoom-in; }
  .chapter__media :global(button[data-lb] img) { width: 100%; height: 100%; object-fit: cover; }
  .tally__row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px var(--gap); margin-top: 56px; }
  .tally .figure-num small { font-size: 0.3em; letter-spacing: -0.01em; }
  .tally__row p:last-child { margin-top: 16px; font-size: var(--t-body); max-width: 30ch; }
  @media (max-width: 900px) {
    .hrt__pair, .tally__row { grid-template-columns: 1fr; }
    .hrt__clips { grid-template-columns: 1fr 1fr; }
    .hrt__clips > :global(*) { grid-column: auto !important; grid-row: auto !important; }
    .hrt__clips :global(.hrt__wide) { grid-column: 1 / -1 !important; }
  }
</style>
