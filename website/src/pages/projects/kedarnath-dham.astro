---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Clip from '../../components/Clip.astro';
import Photo from '../../components/Photo.astro';
import Gallery from '../../components/Gallery.astro';
import NextProjects from '../../components/NextProjects.astro';

const scope = [
  'Excavation', 'Concreting', 'Cutting, binding and fixing reinforcement', 'Formwork',
  'Structural steel trusses', 'False ceilings', 'Tile, Kota stone and granite', 'Doors, windows and ventilators',
  'Stone cladding', 'Plumbing', 'Electrical work', 'Painting and finishing',
];
---

<BaseLayout title="Kedarnath Dham — CP Systems" description="Pilgrim accommodation blocks Q2Q and Q1N at Shri Kedarnath Dham, built from excavation to finishing in Himalayan conditions.">
  <PageHero
    title="Kedarnath Dham"
    lead="Pilgrim accommodation at Shri Kedarnath Dham, taken from excavation to the last coat of paint in a short Himalayan season."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Projects' }, { label: 'Kedarnath Dham' }]}
    image="/images/expansion/kedarnath_q1n_1.jpg"
    imageAlt="Pilgrim accommodation block Q1N at Kedarnath"
    facts={[
      { label: 'Blocks', value: 'Q2Q and Q1N' },
      { label: 'Category', value: 'Civil & mechanical' },
      { label: 'Location', value: 'Kedarnath, Uttarakhand' },
    ]}
  />

  <section class="section" id="content" aria-labelledby="ov-h">
    <div class="wrap split">
      <div class="split__a" data-reveal>
        <h2 id="ov-h">Rooms for pilgrims at 3,583 m</h2>
        <p class="lead" style="margin-top:24px">Blocks Q2Q and Q1N give pilgrims somewhere warm to sleep at one of India's most sacred sites.</p>
        <p style="margin-top:18px">Every bag of cement and length of steel came up the valley; altitude and weather made the programme short and the work technically demanding. CPS did all of it, structure to finish.</p>
        <ul class="scope" style="margin-top:32px">{scope.map((s) => <li>{s}</li>)}</ul>
      </div>
      <div class="split__b kd__media" data-gallery>
        <Clip name="kedarnath-slab" />
        <Clip name="kedarnath-finishes" />
        <Photo src="/images/pdf_page_14_img_116.jpg" caption="Inside a finished room, Block Q2Q" ratio="ratio-45" showCaption class="kd__wide" />
      </div>
    </div>
  </section>

  <section class="section field-navy" aria-label="Photographs of Block Q2Q">
    <Gallery as="h2" title="Q2Q, frame to finish" items={[
      { src: '/images/pdf_page_14_img_118.jpg', caption: 'Block Q2Q frame going up, mixer on the slab' },
      { src: '/images/pdf_page_13_img_113.jpg', caption: 'Kedarnath temple under winter snow', tall: true },
      { src: '/images/pdf_page_13_img_112.jpg', caption: 'Block Q2Q facade', tall: true },
      { src: '/images/pdf_page_13_img_115.jpg', caption: 'Stone-clad facade and timber windows', tall: true },
      { src: '/images/pdf_page_14_img_117.jpg', caption: 'Facade, Block Q2Q', tall: true },
      { src: '/images/pdf_page_13_img_114.jpg', caption: 'Finished veranda with stone flooring', tall: true },
      { src: '/images/expansion/kedarnath_q1n_2.jpg', caption: 'Block Q1N facade', tall: true },
      { src: '/images/expansion/kedarnath_q1n_3.jpg', caption: 'Block Q1N veranda', tall: true },
    ]} />
  </section>

  <NextProjects current="/projects/kedarnath-dham/" />
</BaseLayout>

<style>
  .kd__media { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap); }
  .kd__media :global(.kd__wide) { grid-column: 1 / -1; }
</style>
