---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import GranitePicker from '../../components/GranitePicker.astro';
import NextProjects from '../../components/NextProjects.astro';
---

<BaseLayout title="Kekri Granite Mine — CP Systems" description="A one-hectare granite mine at Kekri, Rajasthan, producing Steel Grey, Black Galaxy and Red Galaxy granite.">
  <PageHero
    title="Kekri Granite Mine"
    lead="One hectare in Rajasthan, three dark granites, and a processing unit at Rajsamand that turns blocks into finished stone."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Projects' }, { label: 'Kekri Granite Mine' }]}
    image="/images/pdf_page_12_img_110.jpg"
    imageAlt="Granite blocks under the gantry at the processing yard"
    facts={[
      { label: 'Area', value: '1 hectare' },
      { label: 'Reserves', value: '~1 million MT' },
      { label: 'Products', value: '3 granites' },
      { label: 'Processing', value: 'Rajsamand, Udaipur' },
    ]}
  />

  <section class="section" id="content" aria-labelledby="ov-h">
    <div class="wrap split">
      <div class="split__a" data-reveal>
        <h2 id="ov-h">A small mine, three stones</h2>
        <p class="lead" style="margin-top:24px">Kekri produces Steel Grey, Black Galaxy and Red Galaxy granite from about 1 million MT of reserves.</p>
        <p style="margin-top:18px">Blocks go to the CPS processing unit at Rajsamand near Udaipur, where they are cut and finished for flooring, countertops and facades.</p>
      </div>
      <div class="split__b kk" data-gallery>
        <Photo src="/images/pdf_page_9_img_90.jpg" caption="Blocks lifted out of the Kekri pit" ratio="ratio-32" showCaption class="kk__wide" />
        <Photo src="/images/pdf_page_9_img_88.jpg" caption="Block stock at the quarry edge" ratio="ratio-11" showCaption />
        <Photo src="/images/pdf_page_12_img_110.jpg" caption="Gantry and block yard at the processing unit" ratio="ratio-11" showCaption />
      </div>
    </div>
  </section>

  <section class="section field-surface" aria-label="Kekri granite varieties">
    <div class="wrap">
      <GranitePicker only={['steel-grey', 'black-galaxy', 'red-galaxy']} title="Kekri granites" />
    </div>
  </section>

  <section class="section" aria-labelledby="proc-h">
    <div class="wrap">
      <h2 id="proc-h" data-reveal><span>Processing at Rajsamand</span></h2>
      <div class="kk__proc" data-gallery>
        <Photo src="/images/pdf_page_12_img_107.jpg" caption="Block cutter at the Rajsamand unit" ratio="ratio-32" showCaption />
        <Photo src="/images/pdf_page_12_img_106.jpg" caption="Inside the cutting shed" ratio="ratio-32" showCaption />
        <Photo src="/images/pdf_page_12_img_110.jpg" caption="Blocks waiting under the gantry" ratio="ratio-32" showCaption />
      </div>
    </div>
  </section>

  <NextProjects current="/projects/kekri-mine/" />
</BaseLayout>

<style>
  .kk { display: grid; grid-template-columns: 1fr 1fr; gap: 32px var(--gap); }
  .kk > :global(.kk__wide) { grid-column: 1 / -1; }
  .kk__proc { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); margin-top: 48px; }
  @media (max-width: 900px) { .kk__proc { grid-template-columns: 1fr; } }
</style>
