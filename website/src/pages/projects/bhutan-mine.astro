---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Clip from '../../components/Clip.astro';
import Photo from '../../components/Photo.astro';
import GranitePicker from '../../components/GranitePicker.astro';
import NextProjects from '../../components/NextProjects.astro';
---

<BaseLayout title="Bhutan Granite Mine — CP Systems" description="An 85-acre granite mine in Wangdue, Bhutan, run by Karma CP Systems, producing CP-DRUK White Galaxy granite.">
  <PageHero
    title="Bhutan Granite Mine"
    lead="Eighty-five acres of white granite above the Wangdue valley, quarried by wire saw and finished at our own processing unit."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Projects' }, { label: 'Bhutan Granite Mine' }]}
    clip="bhutan-blocks-valley"
    facts={[
      { label: 'Area', value: 'About 85 acres' },
      { label: 'Reserves', value: '8 million MT' },
      { label: 'Product', value: 'CP-DRUK White Galaxy' },
      { label: 'Processing unit', value: '5 acres, Tagena' },
    ]}
  />

  <section class="section" id="content" aria-labelledby="ov-h">
    <div class="wrap split">
      <div class="split__a" data-reveal>
        <h2 id="ov-h">From the bench to the slab</h2>
        <p class="lead" style="margin-top:16px">The mine is run by Karma CP Systems Private Limited, a CP Systems subsidiary, and produces CP-DRUK White Galaxy for flooring, countertops and facades.</p>
        <p style="margin-top:18px">Blocks are freed from the face with diamond wire saws, squared on the bench, stacked for dispatch and cut into slabs on gang saws at Tagena.</p>
      </div>
      <div class="split__b bt__pair" data-gallery>
        <Clip name="bhutan-wire-saw" />
        <Clip name="granite-processing" />
      </div>
    </div>
  </section>

  <section class="section field-navy" aria-labelledby="q-h">
    <div class="wrap">
      <h2 id="q-h" data-reveal><span>A day on the quarry</span></h2>
      <div class="bt__grid" data-gallery>
        <Clip name="bhutan-quarry-face" class="bt__a" ratio="ratio-45" />
        <Clip name="bhutan-bench" class="bt__b" ratio="ratio-45" />
        <Clip name="bhutan-stockyard" class="bt__c" ratio="ratio-45" />
        <Clip name="bhutan-overlook" class="bt__d" ratio="ratio-45" />
        <Photo src="/images/pdf_page_6_img_76.jpg" caption="Excavator turning a block off the face" ratio="ratio-169" showCaption class="bt__e" />
        <Photo src="/images/pdf_page_6_img_75.jpg" caption="A block freed from the face" ratio="ratio-169" showCaption class="bt__f" />
        <Photo src="/images/pdf_page_6_img_73.jpg" caption="Squared blocks ready for dispatch" ratio="ratio-169" showCaption class="bt__g" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="unit-h">
    <div class="wrap">
      <div class="split" data-reveal>
        <h2 id="unit-h" class="split__a">The Tagena processing unit</h2>
        <p class="lead split__b">Five acres in a forested fold of the valley, with a gantry yard for blocks, a cutting shed and stock of finished White Galaxy slabs.</p>
      </div>
      <div class="unit" data-gallery>
        <Photo src="/images/bhutan-factory/unit-in-valley.jpg" caption="The processing unit at Tagena, Wangdue" ratio="ratio-169" showCaption class="unit__a" />
        <Photo src="/images/bhutan-factory/yard-gantry.jpg" caption="Gantry crane over the block yard" ratio="ratio-169" showCaption />
        <Photo src="/images/bhutan-factory/finished-slabs.jpg" caption="Finished White Galaxy slabs in the shed" ratio="ratio-169" showCaption />
        <Photo src="/images/bhutan-factory/cut-blocks.jpg" caption="Cut pieces stacked for dispatch" ratio="ratio-169" showCaption />
        <Photo src="/images/bhutan-factory/processing-shed.jpg" caption="The cutting shed" ratio="ratio-169" showCaption />
      </div>
    </div>
  </section>

  <section class="section field-surface" aria-label="CP-DRUK White Galaxy granite">
    <div class="wrap">
      <GranitePicker only={['white-galaxy']} title="CP-DRUK White Galaxy" />
    </div>
  </section>

  <section class="section" aria-labelledby="craft-h">
    <div class="wrap">
      <div class="split" data-reveal>
        <h2 id="craft-h" class="split__a">Carved from the same stone</h2>
        <p class="lead split__b">Basins, stupas and panels carved from Bhutan granite, for homes, gardens, meditation spaces and cultural buildings.</p>
      </div>
      <div class="craft" data-gallery>
        <Photo src="/images/pdf_page_7_img_80.jpg" caption="Granite stupa" ratio="ratio-45" showCaption />
        <Photo src="/images/pdf_page_7_img_79.jpg" caption="Granite wash basin" ratio="ratio-45" showCaption />
        <Photo src="/images/pdf_page_7_img_81.jpg" caption="Carved granite panels" ratio="ratio-45" showCaption />
        <Photo src="/images/pdf_page_7_img_78.jpg" caption="Granite garden table and benches" ratio="ratio-45" showCaption />
      </div>
    </div>
  </section>

  <NextProjects current="/projects/bhutan-mine/" />
</BaseLayout>

<style>
  .bt__pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap); align-items: start; }
  .bt__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 28px var(--gap); margin-top: 32px; align-items: start; }
  .bt__grid > :global(.bt__a), .bt__grid > :global(.bt__b), .bt__grid > :global(.bt__c), .bt__grid > :global(.bt__d) { grid-column: span 3; }
  .bt__grid > :global(.bt__e), .bt__grid > :global(.bt__f), .bt__grid > :global(.bt__g) { grid-column: span 4; }
  .unit { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-flow: dense; gap: 24px var(--gap); margin-top: 28px; }
  .unit > :global(.unit__a) { grid-column: 1 / span 2; grid-row: span 2; }
  .unit > :global(.unit__a .media) { aspect-ratio: auto; flex: 1; min-height: 240px; }
  @media (max-width: 900px) { .unit { grid-template-columns: 1fr 1fr; } .unit > :global(.unit__a) { grid-column: 1 / -1; grid-row: auto; } .unit > :global(.unit__a .media) { aspect-ratio: 16 / 9; flex: none; } }
  .craft { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap); margin-top: 28px; }
  @media (max-width: 900px) {
    .bt__grid { grid-template-columns: 1fr 1fr; }
    .bt__grid > :global(*) { grid-column: span 1 !important; }
    .craft { grid-template-columns: 1fr 1fr; }
  }
</style>
