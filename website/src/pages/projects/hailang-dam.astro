---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Chapter from '../../components/Chapter.astro';
import Clip from '../../components/Clip.astro';
import Gallery from '../../components/Gallery.astro';
import Compare from '../../components/Compare.astro';
import NextProjects from '../../components/NextProjects.astro';
---

<BaseLayout title="Hailang Dam (VPHEP) — CP Systems" description="Restoration of the gate groove, pier and side walls in the diversion tunnel of the 444 MW Vishnugad Pipalkoti Hydroelectric Project, Chamoli.">
  <PageHero
    title="Hailang Dam"
    lead="Rebuilding the gate grooves of a diversion tunnel at the 444 MW Vishnugad Pipalkoti project, with the river still running through it."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Projects' }, { label: 'Hailang Dam (VPHEP)' }]}
    clip="hailang-cofferdam-aerial"
    facts={[
      { label: 'Client', value: 'THDCIL' },
      { label: 'Location', value: 'Helang, Chamoli' },
      { label: 'Capacity', value: '444 MW' },
      { label: 'Flow during work', value: '50–60 cumec' },
    ]}
  />

  <nav class="pindex" aria-label="Parts of the Hailang work">
    <div class="pindex__track">
      <a href="#content">The job</a>
      <a href="#method">Method</a>
      <a href="#phase1">Phase 1, right gate</a>
      <a href="#phase2">Phase 2, left gate</a>
    </div>
  </nav>

  <section class="section" id="content" aria-labelledby="ov-h">
    <div class="wrap split">
      <div class="split__a" data-reveal>
        <h2 id="ov-h">Two gates, one tunnel, no shutdown</h2>
        <p class="lead" style="margin-top:16px">Two gates sit in the 10.5 × 10.5 m box section of the diversion tunnel, about 16 m from the portal and 50 m from the intake. Their grooves, pier and side walls were badly damaged.</p>
        <p style="margin-top:18px">CPS repaired them one side at a time across two lean seasons: the right gate in 2024, the left in 2025. The tunnel kept carrying 50–60 cumec the whole time.</p>
      </div>
      <div class="split__b">
        <Compare
          before="/images/slide_11_img_1.jpg" after="/images/slide_16_img_1.jpg"
          beforeLabel="As found" afterLabel="Repaired"
          beforeCaption="Damage inside the diversion tunnel, before repair"
          afterCaption="The repaired gate groove, phase 1"
        />
      </div>
    </div>
  </section>

  <section id="method" class="section field-navy" aria-labelledby="m-h">
    <div class="wrap">
      <div class="split">
        <h2 id="m-h" class="split__a" data-reveal><span>How the repair was done</span></h2>
        <p class="lead split__b" style="color:var(--on-navy)" data-reveal><span>Twelve steps, the same on each side, from cutting a way in through the tunnel roof to closing it again with a steel plate.</span></p>
      </div>
      <ol class="steps" data-reveal>
        <li>Debris removed from the top slab of the DT</li>
        <li>DT top slab cut open with a diamond wire saw</li>
        <li>Coffer dam of boulder-filled MS boxes in 50–60 cumec of flow</li>
        <li>MS boxes lowered into the flowing river by crane</li>
        <li>Loose concrete scaled off with breakers</li>
        <li>New reinforcement drilled, anchored and fixed</li>
        <li>Micro concrete poured above and under water</li>
        <li>Cracks and honeycombing sealed with epoxy putty</li>
        <li>Concrete surfaces repaired with epoxy mortar</li>
        <li>Three-component epoxy grout in the groove and T guide plate</li>
        <li>Boulder-filled MS boxes removed</li>
        <li>MS cover plate fabricated and fixed over the cut</li>
      </ol>
      <div class="method__clips" data-gallery>
        <Clip name="hailang-wire-saw-dt" />
        <Clip name="hailang-ms-boxes" />
        <Clip name="hailang-crane" />
      </div>
    </div>
  </section>

  <Chapter id="phase1" title="Phase 1: right bay and gate groove" when="Jan – Mar 2024" whenNote="Lean season" pair
    scope={['DT slab cut for access', 'Temporary diversion made inside the tunnel', 'Pier and side walls rebuilt', 'Concrete placed through hopper and pipe']}>
    <p>The right gate came first: open the slab, push the water to one side of the tunnel, and rebuild the pier and walls in the dry half.</p>
    <Fragment slot="media">
      <Clip name="hailang-opening-rebar" />
      <Clip name="hailang-surface-repair" />
    </Fragment>
    <Gallery slot="row" title="Phase 1, photographed" items={[
      { src: '/images/slide_8_img_1.jpg', caption: 'Removing debris from the DT' },
      { src: '/images/slide_8_img_2.jpg', caption: 'Marking the DT slab for cutting', tall: true },
      { src: '/images/slide_10_img_1.jpg', caption: 'Opening made by cutting the DT slab', tall: true },
      { src: '/images/slide_11_img_1.jpg', caption: 'Damage inside the diversion tunnel' },
      { src: '/images/slide_12_img_1.jpg', caption: 'Temporary diversion for the right bay' },
      { src: '/images/slide_14_img_1.jpg', caption: 'Reinforcement and concreting through the hopper', tall: true },
      { src: '/images/slide_14_img_2.jpg', caption: 'Pier reinforcement', tall: true },
      { src: '/images/slide_15_img_2.jpg', caption: 'Concreting through hopper and pipe', tall: true },
      { src: '/images/slide_16_img_1.jpg', caption: 'Completed: the repaired gate groove', tall: true },
    ]} />
  </Chapter>

  <Chapter id="phase2" title="Phase 2: left bay and gate groove" when="Dec 2024 – Mar 2025" whenNote="The next lean season" field="surface" flip pair
    scope={['Left side DT slab cut for an approach', 'Temporary diversion inside the tunnel', 'Rebaring of the damaged left wall', 'Micro concrete poured under water', 'MS slab cover fabricated and placed']}>
    <p>A year later the same sequence on the left: a new cut in the slab, the water moved the other way, and the left wall rebuilt and closed.</p>
    <Fragment slot="media">
      <Clip name="hailang-left-slab" />
      <Clip name="hailang-rebaring" />
      <Clip name="hailang-chute-concreting" />
      <Clip name="hailang-opening" />
    </Fragment>
    <Gallery slot="row" title="Phase 2, photographed" items={[
      { src: '/images/slide_18_img_1.jpg', caption: 'Cutting the left side DT slab' },
      { src: '/images/slide_18_img_2.jpg', caption: 'Making an approach to the damage', tall: true },
      { src: '/images/slide_19_img_1.jpg', caption: 'THDC inspection and temporary diversion' },
      { src: '/images/slide_19_img_2.jpg', caption: 'Temporary diversion inside the tunnel', tall: true },
      { src: '/images/slide_20_img_1.jpg', caption: 'Rebaring the damaged left wall' },
      { src: '/images/slide_21_img_1.jpg', caption: 'Pouring underwater micro concrete' },
      { src: '/images/slide_22_img_1.jpg', caption: 'Fabricating the MS slab cover' },
      { src: '/images/slide_22_img_2.jpg', caption: 'Placing the cover over the cut', tall: true },
    ]} />
  </Chapter>

  <NextProjects current="/projects/hailang-dam/" />
</BaseLayout>

<style>
  .steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 var(--gap); margin-top: 32px; counter-reset: step; }
  .steps li { counter-increment: step; display: grid; grid-template-columns: 2.25em 1fr; gap: 12px; padding: 18px 0; font-size: var(--t-body); color: var(--on-navy); box-shadow: inset 0 -2px 0 rgba(255, 255, 255, 0.1); } /* taste-skill-ignore: state indicator or list separator, not a resting shadow */
  .steps li::before { content: counter(step); font-weight: 800; font-size: 1.375rem; color: var(--gold); line-height: 1.1; font-variant-numeric: tabular-nums; }
  .method__clips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); margin-top: 32px; }
  @media (max-width: 900px) { .steps, .method__clips { grid-template-columns: 1fr; } }
</style>
