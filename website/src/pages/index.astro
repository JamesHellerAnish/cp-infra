---
import BaseLayout from '../layouts/BaseLayout.astro';
import Clip from '../components/Clip.astro';
import IndiaMap from '../components/IndiaMap.astro';
import clips from '../data/clips.json';

const reel = clips['home-reel'];

// The reel is five four-second shots; the label in the hero's corner follows them.
const shots = [
  { at: 0, name: 'Badrinath Dham', what: 'building an approach into the Alaknanda', href: '/projects/badrinath-dham/' },
  { at: 4, name: 'Hailang Dam', what: 'coffer dam of boulder-filled MS boxes', href: '/projects/hailang-dam/' },
  { at: 8, name: 'Bhutan Granite Mine', what: 'blocks on the bench above Wangdue', href: '/projects/bhutan-mine/' },
  { at: 12, name: 'Tehri Dam', what: 'concreting the ramp in a 35-day shutdown', href: '/projects/tehri-dam/' },
  { at: 16, name: 'Badrinath Dham', what: 'a crew crossing the river in a bucket', href: '/projects/badrinath-dham/' },
];

const specialities = [
  { name: 'Hydropower & river dredging', what: 'Dredging, tunnel and spillway repair, gate grooves, grouting and epoxy, usually inside a shutdown.', img: '/media/posters/tehri-dredging.jpg', alt: 'Dredging the Bhagirathi below Tehri Dam', href: '/speciality/hydropower/' },
  { name: 'Civil & mechanical works', what: 'Riverfronts, pilgrim buildings, treatment plants, pipeline coating and fire protection.', img: '/media/posters/badrinath-riverfront-wall.jpg', alt: 'Riverfront wall at Badrinath', href: '/speciality/civil/' },
  { name: 'Mining & exploration', what: 'Granite quarried in Bhutan and Rajasthan, then cut and finished in our own units.', img: '/media/posters/bhutan-wire-saw.jpg', alt: 'Wire saw cutting granite in Bhutan', href: '/speciality/mining/' },
];

const flagship = [
  { name: 'Tehri Dam', clip: 'tehri-ramp-concreting', line: 'Dredging, baffle wall, HRT/TRT and intake repair', fact: '2.5 lakh cum dredged in two shutdowns', href: '/projects/tehri-dam/' },
  { name: 'Badrinath Dham', clip: 'badrinath-bucket-crossing', line: 'Riverfronts A and F1, a footbridge, a civic centre', fact: 'Foundations 5–7 m below the riverbed', href: '/projects/badrinath-dham/' },
  { name: 'Hailang Dam', clip: 'hailang-cofferdam-aerial', line: 'Gate groove restoration, VPHEP 444 MW', fact: 'Repaired against 50–60 cumec of flow', href: '/projects/hailang-dam/' },
  { name: 'Bhutan Granite Mine', clip: 'bhutan-wire-saw', line: 'CP-DRUK White Galaxy, Wangdue', fact: '8 million MT of reserves on 85 acres', href: '/projects/bhutan-mine/' },
] as const;

const more = [
  { name: 'Kedarnath Dham', place: 'Uttarakhand, 3,583 m', what: 'Pilgrim accommodation blocks Q2Q and Q1N, built between snowfalls.', img: '/images/expansion/kedarnath_q1n_1.jpg', alt: 'Pilgrim accommodation block at Kedarnath', href: '/projects/kedarnath-dham/' },
  { name: 'Kekri Granite Mine', place: 'Rajasthan', what: 'Steel Grey, Black Galaxy and Red Galaxy, processed at Rajsamand.', img: '/images/pdf_page_9_img_90.jpg', alt: 'Granite blocks in the Kekri quarry', href: '/projects/kekri-mine/' },
  { name: 'Koteshwar, Maneri Bhali, Tapovan', place: 'Uttarakhand and J&K', what: 'Slope stabilisation, spillway and roller bucket repair, a TBM freed by grouting.', img: '/images/other_projects/maneri_bhali_1.jpg', alt: 'Spillway repair at Maneri Bhali', href: '/projects/other/' },
  { name: 'Civil works across India', place: 'Delhi, Punjab, Maharashtra, MP', what: 'Expressway fire protection, CETPs, 294 km of pipeline coating, refinery insulation.', img: '/media/posters/noida-building.jpg', alt: 'Column and slab work on a building in Noida', href: '/speciality/civil/' },
];

// Working windows, January 2023 = month 0. Dates are from the project records.
const MONTHS = 30;
const monthName = (m: number) => new Date(2023, m, 1).toLocaleString('en-GB', { month: 'short', year: 'numeric' });
const windows = [
  { id: 'w-tehri1', site: 'Tehri Dam', job: 'River dredging and baffle wall, phase 1', from: 1, to: 6, when: 'Feb – Jul 2023', clip: 'tehri-dredging', fact: '~1 lakh cum dredged and hauled 14–15 km, 47 m baffle wall across the Bhagirathi', href: '/projects/tehri-dam/#phase1-dredging' },
  { id: 'w-hailang1', site: 'Hailang Dam', job: 'Right side gate groove, phase 1', from: 12, to: 14, when: 'Jan – Mar 2024', clip: 'hailang-cofferdam-aerial', fact: 'Lean season only: the diversion tunnel still carried 50–60 cumec', href: '/projects/hailang-dam/#phase1' },
  { id: 'w-tehri2', site: 'Tehri Dam', job: 'Dredging and ramps, phase 2', from: 17, to: 18, when: 'Jun – Jul 2024', clip: 'tehri-ramp-concreting', fact: '1,50,000 cum dredged and 14,400 cum concreted inside a 35-day shutdown', href: '/projects/tehri-dam/#phase2-dredging' },
  { id: 'w-hailang2', site: 'Hailang Dam', job: 'Left side gate groove, phase 2', from: 23, to: 26, when: 'Dec 2024 – Mar 2025', clip: 'hailang-rebaring', fact: 'Slab cut by wire saw, new steel anchored, micro concrete poured under water', href: '/projects/hailang-dam/#phase2' },
  { id: 'w-intake', site: 'Tehri Dam', job: 'Epoxy treatment, intake structures 1 & 2', from: 28, to: 29, when: '31 May – 14 Jun 2025', image: '/images/slide_39_img_0.jpg', fact: 'Planned for 30 days, handed over in 16', href: '/projects/tehri-dam/#epoxy-intake' },
] as const;
const startMonth = 17;

// Turnover, in crore rupees.
const turnover = [
  { year: 'FY 2022–23', cr: 24.3 },
  { year: 'FY 2023–24', cr: 61.9, growth: '+154.7%' },
  { year: 'FY 2024–25', cr: 143, growth: '+130.9%' },
];
const maxCr = 143;
---

<BaseLayout title="CP Systems Pvt. Ltd. — Dams, tunnels, riverfronts and mines since 1999">

  <!-- Hero: the sites themselves, one after another -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media">
      <video id="heroReel" autoplay muted loop playsinline preload="auto" poster={reel.poster} aria-hidden="true">
        <source src={reel.src} type="video/mp4" />
      </video>
    </div>
    <div class="hero__body wrap">
      <div class="hero__text">
        <h1 id="hero-title">Dams, tunnels,<br />rivers and rock</h1>
        <p class="hero__lead">CP Systems builds, repairs, dredges and quarries in the Himalaya, Rajasthan and Bhutan, often inside a shutdown or a lean season.</p>
        <div class="hero__acts">
          <a class="btn" href="#flagship">See the projects</a>
          <a class="btn btn--paper" href="/contact/">Discuss a project</a>
        </div>
      </div>
      <div class="hero__side">
        <a class="hero__now" id="heroNow" href={shots[0].href}>
          <span class="hero__now-name">{shots[0].name}</span>
          <span class="hero__now-what">{shots[0].what}</span>
        </a>
        <button class="hero__pause" id="heroPause" type="button" aria-label="Pause the site reel">Pause reel</button>
      </div>
    </div>
  </section>

  <!-- The company in four figures -->
  <section class="stats field-deep" aria-label="CP Systems in brief">
    <dl class="stats__list wrap">
      <div><dt>Established, run from New Delhi</dt><dd>1999</dd></div>
      <div><dt>Sites and units in India and Bhutan</dt><dd>22</dd></div>
      <div><dt>Granite reserves in Bhutan and Kekri</dt><dd>9 million MT</dd></div>
      <div><dt>Award for industrial contribution</dt><dd>Udyog Ratan</dd></div>
    </dl>
  </section>

  <!-- Who we are and what we do -->
  <section class="about section" aria-labelledby="about-title">
    <div class="about__grid wrap">
      <div class="about__text" data-reveal>
        <h2 id="about-title">Hard ground since 1999</h2>
        <p class="lead">CPS works where timing is tight and access is worse: under running rivers, inside tunnels, at 3,000 metres and in the quarry.</p>
        <p>Clients are government departments, public sector undertakings such as THDC India, turnkey operators and builders. The work spans civil, anti-corrosive, mechanical and electrical execution, and a growing practice in civil and structural design.</p>
        <a class="link" href="/about/">How CPS works</a>
      </div>
      <ul class="about__specs" data-reveal>
        {specialities.map((s) => (
          <li>
            <a class="spec" href={s.href}>
              <div class="media spec__img"><img src={s.img} alt={s.alt} loading="lazy" /></div>
              <div class="spec__body">
                <h3>{s.name}</h3>
                <p>{s.what}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Flagship projects: four sites, each with its own footage -->
  <section class="flag section field-surface" id="flagship" aria-labelledby="flag-title">
    <div class="wrap">
      <div class="shead" data-reveal>
        <h2 id="flag-title">Flagship projects</h2>
        <p>Four jobs that show the range: a dam in a shutdown, a shrine town on a glacial river, a tunnel under flow, a mine across the border.</p>
      </div>
      <div class="flag__grid">
        {flagship.map((f) => (
          <article class="flag__card">
            <Clip name={f.clip} bare ratio="ratio-11" class="flag__clip" />
            <div class="flag__body">
              <h3><a href={f.href}>{f.name}</a></h3>
              <p class="flag__line">{f.line}</p>
              <p class="flag__fact">{f.fact}</p>
              <a class="flag__go" href={f.href} aria-hidden="true" tabindex="-1">See the project</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- The live thing: working windows, scrubbed month by month -->
  <section class="windows section field-navy" aria-labelledby="win-title">
    <div class="wrap">
      <div class="shead" data-reveal>
        <h2 id="win-title">Work happens in windows</h2>
        <p>Shutdowns, lean seasons and handover dates decide when a crew can stand in the river. Drag through 2023 to 2025 to see where CPS was working.</p>
      </div>

      <div class="windows__body">
        <div class="gantt" id="gantt" style={`--months:${MONTHS}`}>
          <div class="gantt__years" aria-hidden="true">
            <span style="grid-column: 1 / span 12">2023</span>
            <span style="grid-column: 13 / span 12">2024</span>
            <span style="grid-column: 25 / span 6">2025</span>
          </div>
          {windows.map((w) => (
            <div class="gantt__row">
              <span class="gantt__label">{w.site}</span>
              <button type="button" class="gantt__bar" data-from={w.from} data-to={w.to}
                style={`grid-column: ${w.from + 1} / ${w.to + 2}`} aria-label={`${w.site}: ${w.job}, ${w.when}`}></button>
            </div>
          ))}
          <div class="gantt__scrub">
            <label for="month" class="gantt__month" id="monthOut">{monthName(startMonth)}</label>
            <input id="month" type="range" min="0" max={MONTHS - 1} value={startMonth} step="1" aria-valuetext={monthName(startMonth)} />
          </div>
          <span class="gantt__head" id="playhead" aria-hidden="true" style={`--m:${startMonth}`}></span>
        </div>

        <div class="windows__panel" aria-live="polite">
          {windows.map((w) => (
            <article class="win" id={w.id} data-from={w.from} data-to={w.to}>
              <div class="win__media">
                {'clip' in w ? <Clip name={w.clip} bare ratio="ratio-169" /> : <div class="media ratio-169"><img src={w.image} alt="Intake structure after epoxy treatment" loading="lazy" /></div>}
              </div>
              <p class="win__when">{w.when}</p>
              <h3>{w.site}: {w.job}</h3>
              <p>{w.fact}</p>
              <a class="link" href={w.href}>Read the phase</a>
            </article>
          ))}
          <article class="win win--gap" id="w-gap" hidden>
            <p class="win__when" id="gapWhen"></p>
            <h3>Between windows</h3>
            <p>No shutdown on record this month. Crews mobilise, plan the next window and keep the year-round work going: Badrinath runs April to December each year, and the mines in Bhutan and Rajasthan keep cutting.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- More of the work, two by two -->
  <section class="more section" aria-labelledby="more-title">
    <div class="wrap">
      <div class="shead" data-reveal>
        <h2 id="more-title">More of the work</h2>
        <p>Pilgrim buildings, a second granite mine, dam rehabilitation across the Garhwal, and civil and protective work across India.</p>
      </div>
      <ul class="more__grid" data-reveal>
        {more.map((m) => (
          <li>
            <a class="mc" href={m.href}>
              <div class="media mc__img"><img src={m.img} alt={m.alt} loading="lazy" /></div>
              <div class="mc__body">
                <p class="mc__place">{m.place}</p>
                <h3>{m.name}</h3>
                <p class="mc__what">{m.what}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Growth: three years of turnover -->
  <section class="growth section field-deep" aria-labelledby="growth-title">
    <div class="growth__grid wrap">
      <div class="growth__text" data-reveal>
        <h2 id="growth-title">Growth</h2>
        <p class="growth__num"><span data-roll="143">143</span> Cr</p>
        <p>Turnover in FY 2024–25, in rupees: almost six times the ₹24.3 Cr of two years earlier.</p>
      </div>
      <ol class="bars" data-reveal aria-label="Turnover by financial year">
        {turnover.map((t) => (
          <li class="bars__row">
            <span class="bars__year">{t.year}</span>
            <span class="bars__track"><span class="bars__bar" style={`--w:${(t.cr / maxCr) * 100}%`}></span></span>
            <span class="bars__val">₹{t.cr} Cr{t.growth && <small>{t.growth}</small>}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Where we work -->
  <section class="where section" aria-labelledby="where-title">
    <div class="wrap">
      <div class="shead" data-reveal>
        <h2 id="where-title">Pan India and Bhutan</h2>
        <p>From the shrines of Uttarakhand to granite benches in Wangdue and Kekri, run from a head office in New Delhi. Pick a site to see the work.</p>
      </div>
      <IndiaMap />
    </div>
  </section>

  <!-- Contact -->
  <section class="visit" aria-labelledby="visit-title">
    <div class="visit__grid wrap">
      <div class="visit__head">
        <h2 id="visit-title">Bring us the hard one</h2>
        <p>Tell us the site, the window and the problem. We answer within a working day.</p>
      </div>
      <address>501, Krishna Apra Business Square,<br />Netaji Subhash Place, Pitampura,<br />New Delhi 110034</address>
      <dl class="visit__rows">
        <div><dt>Office</dt><dd><a href="tel:01140539469">011 4053 9469</a></dd></div>
        <div><dt>Mobile</dt><dd><a href="tel:+919212150206">+91 92121 50206</a></dd></div>
        <div><dt>Email</dt><dd><a href="mailto:info@cp-infra.in">info@cp-infra.in</a></dd></div>
      </dl>
      <a class="btn btn--navy visit__btn" href="/contact/">Discuss a project</a>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ shots, MONTHS }}>
  // Hero reel: the label names the site on screen; the button pauses the reel.
  const v = document.getElementById('heroReel');
  const now = document.getElementById('heroNow');
  const pause = document.getElementById('heroPause');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduced) { v.removeAttribute('autoplay'); v.pause(); pause.textContent = 'Play reel'; }
  let last = 0;
  v.addEventListener('timeupdate', () => {
    let i = 0;
    for (let k = 0; k < shots.length; k++) if (v.currentTime >= shots[k].at) i = k;
    if (i === last) return;
    last = i;
    now.href = shots[i].href;
    now.querySelector('.hero__now-name').textContent = shots[i].name;
    now.querySelector('.hero__now-what').textContent = shots[i].what;
    now.classList.remove('is-swap'); void now.offsetWidth; now.classList.add('is-swap');
  });
  pause.addEventListener('click', () => {
    if (v.paused) { v.play(); pause.textContent = 'Pause reel'; pause.setAttribute('aria-label', 'Pause the site reel'); }
    else { v.pause(); pause.textContent = 'Play reel'; pause.setAttribute('aria-label', 'Play the site reel'); }
  });
  document.addEventListener('visibilitychange', () => { if (document.hidden) v.pause(); });

  // Working windows: the month slider shows the site at work that month.
  const input = document.getElementById('month');
  const out = document.getElementById('monthOut');
  const head = document.getElementById('playhead');
  const wins = [...document.querySelectorAll('.win:not(.win--gap)')];
  const gap = document.getElementById('w-gap');
  const bars = [...document.querySelectorAll('.gantt__bar')];
  const name = (m) => new Date(2023, m, 1).toLocaleString('en-GB', { month: 'long', year: 'numeric' });
  function set(m) {
    out.textContent = name(m);
    input.setAttribute('aria-valuetext', name(m));
    head.style.setProperty('--m', m);
    let any = false;
    wins.forEach((w) => {
      const on = m >= +w.dataset.from && m <= +w.dataset.to;
      w.hidden = !on || any;
      if (on) any = true;
    });
    bars.forEach((b) => b.classList.toggle('is-on', m >= +b.dataset.from && m <= +b.dataset.to));
    gap.hidden = any;
    document.getElementById('gapWhen').textContent = name(m);
  }
  input.addEventListener('input', () => set(+input.value));
  bars.forEach((b) => b.addEventListener('click', () => { input.value = b.dataset.from; set(+b.dataset.from); input.focus(); }));
  set(+input.value);

  // The figure rolls up once when it comes into view.
  const roll = document.querySelector('[data-roll]');
  if (roll && !reduced) {
    const target = +roll.dataset.roll;
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const t0 = performance.now();
      const step = (t) => {
        const p = Math.min((t - t0) / 1400, 1);
        roll.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }, { threshold: 0.4 });
    io.observe(roll);
  }
</script>

<style>
  /* Hero: shorter than the screen, so the figures below it show on arrival */
  .hero { position: relative; height: min(84svh, 860px); min-height: 540px; color: #fff; display: grid; align-items: end; isolation: isolate; background: #08152b; }
  .hero__media { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .hero__media video { width: 100%; height: 100%; object-fit: cover; }
  .hero__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(3, 10, 24, 0.82) 0%, rgba(3, 10, 24, 0.42) 42%, rgba(3, 10, 24, 0.08) 70%), linear-gradient(to bottom, rgba(3, 10, 24, 0.55), rgba(3, 10, 24, 0) 160px); } /* taste-skill-ignore: photo scrim */
  .hero__body { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 32px; padding-bottom: clamp(28px, 4vw, 56px); }
  .hero h1 { color: #fff; font-size: clamp(2.75rem, 6.2vw, 6rem); line-height: 0.94; }
  .hero__lead { margin-top: 24px; max-width: 44ch; font-size: var(--t-lead); font-weight: 500; line-height: 1.45; }
  .hero__acts { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .hero__side { display: grid; justify-items: end; gap: 14px; text-align: right; }
  .hero__now { display: grid; text-decoration: none; }
  .hero__now-name { font-weight: 800; font-size: var(--t-lead); }
  .hero__now-what { font-size: var(--t-small); color: var(--on-navy-muted); }
  .hero__now.is-swap { animation: swap 600ms var(--ease-out); }
  @keyframes swap { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .hero__pause { height: 44px; padding: 0 18px; font-weight: 700; font-size: var(--t-small); background: rgba(255, 255, 255, 0.16); color: #fff; transition: background-color var(--t-hover); }
  @media (hover: hover) and (pointer: fine) { .hero__pause:hover { background: var(--gold); color: var(--navy-deep); } .hero__now:hover .hero__now-name { text-decoration: underline; text-decoration-color: var(--gold); } }
  @media (max-width: 760px) {
    .hero { height: auto; min-height: 88svh; }
    .hero h1 { font-size: 12.5vw; }
    .hero__body { grid-template-columns: 1fr; gap: 24px; }
    .hero__lead { font-size: 1.0625rem; margin-top: 18px; }
    .hero__acts { margin-top: 24px; }
    .hero__acts .btn { flex: 1 1 auto; }
    .hero__side { grid-template-columns: 1fr auto; justify-items: start; align-items: end; text-align: left; }
  }

  /* Stats strip */
  .stats__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 var(--gap); padding-block: clamp(22px, 2.4vw, 32px); }
  .stats__list div { display: flex; flex-direction: column; gap: 4px; align-content: start; padding-left: 18px; box-shadow: inset 3px 0 0 var(--gold); } /* taste-skill-ignore: state indicator or list separator, not a resting shadow */
  .stats__list dd { order: 0; font-size: clamp(1.5rem, 2.4vw, 2.25rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; color: #fff; }
  .stats__list dt { order: 1; font-size: var(--t-small); line-height: 1.4; color: var(--on-navy-muted); font-weight: 500; }
  @media (max-width: 900px) { .stats__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px var(--gap); } }

  /* About and specialities */
  .about__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 40px var(--gap); align-items: start; }
  .about__text { grid-column: 1 / span 4; }
  .about__text .lead { margin-top: 22px; }
  .about__text p + p { margin-top: 16px; }
  .about__text .link { display: inline-block; margin-top: 20px; }
  .about__specs { grid-column: 5 / -1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); }
  .about__specs li { display: flex; }
  .spec { display: flex; flex-direction: column; width: 100%; text-decoration: none; color: inherit; background: var(--navy); color: #fff; }
  .spec__img { aspect-ratio: 4 / 3; }
  .spec__img img { transition: transform 700ms var(--ease-out); }
  .spec__body { flex: 1; display: grid; align-content: start; gap: 8px; padding: 18px 20px 22px; transition: background-color var(--t-hover), color var(--t-hover); }
  .spec h3 { color: #fff; font-size: 1.1875rem; display: flex; justify-content: space-between; gap: 12px; transition: color var(--t-hover); }
  .spec h3::after { content: '→'; color: var(--gold); transition: transform 300ms var(--ease-out), color var(--t-hover); }
  .spec p { font-size: 0.9375rem; line-height: 1.5; color: var(--on-navy-muted); transition: color var(--t-hover); }
  @media (hover: hover) and (pointer: fine) {
    .spec:hover .spec__img img { transform: scale(1.04); }
    .spec:hover .spec__body { background: var(--gold); }
    .spec:hover h3, .spec:hover p { color: var(--navy-deep); }
    .spec:hover h3::after { color: var(--navy-deep); transform: translateX(4px); }
  }
  @media (max-width: 1100px) { .about__text, .about__specs { grid-column: 1 / -1; } }
  @media (max-width: 700px) {
