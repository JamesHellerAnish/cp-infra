---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Clip from '../../components/Clip.astro';

const skills = [
  ['Concreting', 'High-performance concrete above and under water', 'badrinath-wall-concreting'],
  ['Reinforcing', 'Cutting, binding and fixing reinforcement steel', 'badrinath-raft-rebar'],
  ['Building work', 'Complete buildings from foundation to finish', 'kedarnath-finishes'],
  ['Fabrication', 'Structural steel fabricated and erected', 'hailang-opening-rebar'],
  ['Erection', 'Heavy lifting for civil and industrial structures', 'hailang-crane'],
  ['MEP services', 'Plumbing, electrical and mechanical systems', 'noida-building'],
] as const;

const infra = [
  'Passive fire protection, Nagpur–Mumbai Super Expressway',
  'Raw water reservoir excavation, Barmer, Rajasthan',
  'Industrial model township, Rohtak, Haryana',
  'Industrial area infrastructure, Bhorgarh and Bawana',
  'Civil works and site grading, 2 × 700 MW Rajpura Thermal Power',
  '12 MLD and 24 MLD CETPs, Nagloi, Delhi',
  '294 km GAIL gas pipeline joint coating, Jaipur to Loni',
  'Cement mortar lining, Sonia Vihar phases I and II',
  'Railway bridge, Nabha Power Ltd, Rajpura',
  'Shot blasting and epoxy painting, Cairn Energy terminal',
  'Insulation, HMEL Bhatinda Refinery',
  'PU foam insulation and PVC waterproofing, AIIMS Bhopal',
  'Concrete coating with shotcrete, GTCL Bangladesh',
];
---

<BaseLayout title="Civil & mechanical works — CP Systems" description="Concreting, reinforcement, fabrication, erection, building work and MEP services, from pilgrimage sites to refineries and expressways.">
  <PageHero
    title="Civil and mechanical works"
    lead="Foundations to finishing: concrete, steel, fabrication, erection and services, at pilgrimage sites, plants and highways."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Expertise' }, { label: 'Civil & mechanical' }]}
    clip="badrinath-concrete-pump"
  />

  <section class="section" id="content" aria-labelledby="ov-h">
    <div class="wrap split">
      <div class="split__a" data-reveal>
        <h2 id="ov-h">Built to last up there</h2>
        <p class="lead" style="margin-top:24px">Structures, utilities and integrated systems built for durability and safety: structural steel, reinforcement, formwork, concreting and MEP.</p>
        <p style="margin-top:18px">The same crews have built at Kedarnath and Badrinath in snow, and at industrial plants, treatment works and highways across India.</p>
      </div>
      <div class="split__b" data-gallery><Clip name="kedarnath-slab" ratio="ratio-45" /></div>
    </div>
  </section>

  <section class="section field-navy" aria-labelledby="sk-h">
    <div class="wrap">
      <h2 id="sk-h" data-reveal><span>Six trades, one contractor</span></h2>
      <div class="sk" data-gallery>
        {skills.map(([n, d, c]) => (
          <article class="sk__item" data-reveal>
            <Clip name={c} ratio="ratio-32" bare />
            <h3>{n}</h3>
            <p>{d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="pf-h">
    <div class="wrap split">
      <div class="split__a" data-reveal>
        <h2 id="pf-h">Civil portfolio</h2>
        <p class="lead" style="margin-top:24px">Pilgrimage buildings in the Himalaya, and plants, pipelines and highways across the country.</p>
        <nav class="index" style="margin-top:40px" aria-label="Civil projects with pages">
          <a href="/projects/kedarnath-dham/"><span class="index__name">Kedarnath Dham</span><span class="index__what">Pilgrim accommodation</span></a>
          <a href="/projects/badrinath-dham/#bridge-civic"><span class="index__name">Badrinath Civic Centre</span><span class="index__what">Near Badrish Lake</span></a>
        </nav>
      </div>
      <ul class="split__b scope cv">
        {infra.map((i) => <li>{i}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .sk { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 56px var(--gap); margin-top: 56px; }
  .sk__item h3 { color: #fff; font-size: 1.5rem; font-weight: 800; margin: 20px 0 8px; }
  .sk__item p { color: var(--on-navy); }
  .cv { grid-template-columns: 1fr; }
  @media (max-width: 900px) { .sk { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .sk { grid-template-columns: 1fr; } }
</style>
