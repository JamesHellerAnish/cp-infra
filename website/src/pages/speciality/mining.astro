---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Clip from '../../components/Clip.astro';
import Photo from '../../components/Photo.astro';
import GranitePicker from '../../components/GranitePicker.astro';
---

<BaseLayout title="Mining & exploration — CP Systems" description="Granite mining in Bhutan and Rajasthan: CP-DRUK White Galaxy, Steel Grey, Black Galaxy and Red Galaxy, quarried and processed by CPS.">
  <PageHero
    title="Mining and exploration"
    lead="Two granite mines, in Bhutan and Rajasthan, surveyed, drilled, quarried and processed by CPS and its subsidiary."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Expertise' }, { label: 'Mining' }]}
    clip="bhutan-wire-saw"
    facts={[
      { label: 'Mines', value: 'Wangdue and Kekri' },
      { label: 'Reserves', value: '9 million MT' },
      { label: 'Granites', value: '4 varieties' },
    ]}
  />

  <section class="section" id="content" aria-labelledby="ov-h">
    <div class="wrap split">
      <div class="split__a" data-reveal>
        <h2 id="ov-h">Stone from survey to slab</h2>
        <p class="lead" style="margin-top:24px">Surveying, drilling and excavation that turn a hillside into dimension stone, with processing units at Tagena in Bhutan and Rajsamand in Rajasthan.</p>
        <p style="margin-top:18px">The Bhutan mine is run by our subsidiary, Karma CP Systems Private Limited, and holds one of the largest white granite reserves in the region.</p>
      </div>
      <div class="split__b" data-gallery><Clip name="granite-processing" /></div>
    </div>
  </section>

  <section class="section field-navy" aria-labelledby="mines-h">
    <div class="wrap">
      <h2 id="mines-h" data-reveal><span>The two mines</span></h2>
      <div class="mines">
        <a class="mine" href="/projects/bhutan-mine/" data-reveal>
          <div class="media ratio-32"><img src="/media/posters/bhutan-overlook.jpg" alt="Granite blocks above the Wangdue valley" loading="lazy" /></div>
          <h3>Bhutan Granite Mine, Wangdue</h3>
          <p>About 85 acres, 8 million MT of reserves, CP-DRUK White Galaxy.</p>
        </a>
        <a class="mine" href="/projects/kekri-mine/" data-reveal>
          <div class="media ratio-32"><img src="/images/pdf_page_9_img_90.jpg" alt="Blocks in the Kekri pit" loading="lazy" /></div>
          <h3>Kekri Granite Mine, Rajasthan</h3>
          <p>One hectare, about 1 million MT: Steel Grey, Black Galaxy, Red Galaxy.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-label="Granite collection">
    <div class="wrap"><GranitePicker title="The granite collection" /></div>
  </section>

  <section class="section field-surface" aria-labelledby="craft-h">
    <div class="wrap">
      <div class="split" data-reveal>
        <h2 id="craft-h" class="split__a">Sculpture and crafted stone</h2>
        <p class="lead split__b">Hand-carved pieces for homes, gardens, meditation spaces and cultural buildings, inspired by nature and tradition and made to order.</p>
      </div>
      <div class="craft" data-gallery>
        <Photo src="/images/pdf_page_7_img_80.jpg" caption="Granite stupa" ratio="ratio-45" showCaption />
        <Photo src="/images/pdf_page_7_img_79.jpg" caption="Granite wash basin" ratio="ratio-45" showCaption />
        <Photo src="/images/pdf_page_7_img_81.jpg" caption="Carved granite panels" ratio="ratio-45" showCaption />
        <Photo src="/images/pdf_page_7_img_78.jpg" caption="Garden table and benches" ratio="ratio-45" showCaption />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .mines { display: grid; grid-template-columns: 1fr 1fr; gap: 48px var(--gap); margin-top: 48px; }
  .mine { display: grid; gap: 14px; text-decoration: none; }
  .mine h3 { color: #fff; font-size: clamp(1.5rem, 2.2vw, 2rem); font-weight: 800; margin-top: 8px; }
  .mine p { color: var(--on-navy); }
  .mine img { transition: transform 700ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .mine:hover img { transform: scale(1.04); } .mine:hover h3 { color: var(--gold); } }
  .craft { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap); margin-top: 48px; }
  @media (max-width: 900px) { .mines { grid-template-columns: 1fr; } .craft { grid-template-columns: 1fr 1fr; } }
</style>
